<?xml version="1.0" encoding="utf-8"?>
<!--
  VIZEN for the Microsoft Store (MSIX). scripts\build-msix.ps1 fills in the $...$ values: the package identity comes
  from Partner Center (Product management > Product identity), the version from VIZEN.App.csproj.
  VIZEN is a "win32App" (uap10:RuntimeBehavior="win32App", uap10:TrustLevel="mediumIL"): a packaged Win32 app with
  package identity and no file system / registry write virtualization, so it needs no restricted capability other
  than runFullTrust. Its data stays in %LOCALAPPDATA%\VIZEN (shared with the classic installer) and the browsers can read the
  VIZEN Connector native messaging registration it writes under HKEY_CURRENT_USER.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VIZEN</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ro-ro" />
  </Resources>

  <Applications>
    <Application Id="VIZEN" Executable="VIZEN.App.exe" uap10:RuntimeBehavior="win32App" uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="VIZEN"
        Description="Free, open-source overlays for Windows: any window or region on top of your game, in OBS or in a composition."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="VIZEN" />
      </uap:VisualElements>
      <Extensions>
        <!-- "vizen.exe": how the browsers (VIZEN Connector) start a Store VIZEN. -->
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="vizen.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- "Launch at sign-in" (off until the user turns it on; Windows removes it with the package). -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="VIZENStartup" Enabled="false" DisplayName="VIZEN" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
