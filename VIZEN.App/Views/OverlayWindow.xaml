<Window x:Class="VIZEN.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="{Binding Title, StringFormat=VIZEN overlay · {0}}"
        Width="480" Height="270" MinWidth="120" MinHeight="72"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        Background="#FF05070B" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}" FontSize="12"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnRootMouseLeftButtonDown">
        <!-- Live frame, cropped to this overlay's region on the GPU (Viewbox in 0–1 units) -->
        <Rectangle x:Name="WpfVideo" RenderOptions.BitmapScalingMode="Linear">
            <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding Capture.Frame}" Viewbox="{Binding Viewbox}"
                            ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform" />
            </Rectangle.Fill>
        </Rectangle>

        <!-- Native video (swap chain drawn on the capture thread); filled from code when the GPU path is available -->
        <ContentControl x:Name="NativeSlot" Focusable="False" IsTabStop="False" />

        <!-- Status while there is no frame (starting, source closed, failed) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                    Visibility="{Binding Capture.HasFrame, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81E;" FontSize="20" Foreground="{DynamicResource Brush.TextTertiary}" />
            <TextBlock Text="{Binding Capture.StatusText}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- Optional measured-performance indicator (per overlay, off by default) -->
        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="7,3" CornerRadius="5"
                Background="#C0000000" IsHitTestVisible="False"
                Visibility="{Binding ShowPerformance, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF3DD68C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="CaptureLimited">
                                    <Setter Property="Fill" Value="#FFE5484D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="ProcessingLimited">
                                    <Setter Property="Fill" Value="#FFE5484D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="RenderLimited">
                                    <Setter Property="Fill" Value="#FFE5484D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="PresentationLimited">
                                    <Setter Property="Fill" Value="#FFE5484D" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="Unknown">
                                    <Setter Property="Fill" Value="#FFF5A524" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="NoNewFrames">
                                    <Setter Property="Fill" Value="#FFF5A524" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="Paused">
                                    <Setter Property="Fill" Value="#FFF5A524" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="SourceLimited">
                                    <Setter Property="Fill" Value="#FF6EA8FE" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="Capped">
                                    <Setter Property="Fill" Value="#FF6EA8FE" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="Starting">
                                    <Setter Property="Fill" Value="#FF8A8F98" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capture.Health}" Value="Ended">
                                    <Setter Property="Fill" Value="#FF8A8F98" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Capture.BadgeText}" Foreground="White" FontSize="11" FontFamily="{StaticResource Font.Mono}" />
            </StackPanel>
        </Border>

        <!-- Hover chrome: only reachable when the overlay is not click-through -->
        <Border x:Name="HoverOutline" IsHitTestVisible="False" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border x:Name="HoverBar" VerticalAlignment="Top" Height="32" Background="#E00A0D14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Margin="10,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <Button Grid.Column="2" Style="{StaticResource Button.CaptionClose}" Width="36" Height="32"
                        Content="&#xE8BB;" ToolTip="{DynamicResource Overlay.Close}" AutomationProperties.Name="{DynamicResource Overlay.Close}" Command="{Binding CloseCommand}" />
            </Grid>
        </Border>

        <!-- With native video WPF cannot draw over the video window, so the hover bar and the badge move into these. -->
        <Popup x:Name="HoverPopup" PlacementTarget="{Binding ElementName=Root}" Placement="Relative" AllowsTransparency="True"
               Width="{Binding ActualWidth, ElementName=Root}" Focusable="False" />
        <Popup x:Name="BadgePopup" PlacementTarget="{Binding ElementName=Root}" Placement="Relative" AllowsTransparency="True"
               Focusable="False" />
    </Grid>
</Window>
