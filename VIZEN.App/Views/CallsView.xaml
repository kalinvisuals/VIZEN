<UserControl x:Class="VIZEN.App.Views.CallsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:models="clr-namespace:VIZEN.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CallsViewModel}"
             d:DesignWidth="1000" d:DesignHeight="760">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Calls.Title}" Style="{StaticResource Text.PageTitle}" />
                <Border Style="{StaticResource Badge.Success}" Margin="14,4,0,0">
                    <TextBlock Text="{DynamicResource Badge.Ready}" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Calls.Subtitle}" />

            <!-- Detected call windows (real) -->
            <Grid Margin="0,26,0,12">
                <TextBlock Text="{DynamicResource Calls.Detected}" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Link}" Command="{Binding ShowInSourcesCommand}" HorizontalAlignment="Right" Margin="0" AutomationProperties.Name="{DynamicResource Calls.ShowInSources}">
                    <TextBlock Text="{DynamicResource Calls.ShowInSources}" />
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding CallWindows}"
                          Visibility="{Binding HasCallWindows, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:WindowSource}">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brush.SurfaceHover}">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12"
                                                   Visibility="{Binding IsCategoryFromTabTitle, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{DynamicResource Calls.InBrowser}" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12"
                                                   Visibility="{Binding IsCategoryFromTabTitle, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.CreateOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{DynamicResource Calls.OverlayTip}" AutomationProperties.Name="{DynamicResource Calls.MirrorAsOverlay}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81E;" FontSize="12" />
                                            <TextBlock Text="{DynamicResource Calls.MirrorAsOverlay}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Primary}"
                                            Command="{Binding DataContext.CropCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{DynamicResource Calls.CropTip}" AutomationProperties.Name="{DynamicResource Calls.CropParticipants}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7A8;" FontSize="12" Foreground="White" />
                                            <TextBlock Text="{DynamicResource Calls.CropParticipants}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="28"
                    Visibility="{Binding HasCallWindows, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE717;" FontSize="26" Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{DynamicResource Calls.EmptyTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource Calls.EmptyText}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Roadmap for this mode -->
            <TextBlock Text="{DynamicResource Calls.Planned}" Style="{StaticResource Text.Overline}" Margin="0,28,0,12" />
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource Badge.Success}">
                            <TextBlock Text="{DynamicResource Badge.Ready}" />
                        </Border>
                        <TextBlock Text="{DynamicResource Calls.CropTitle}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Calls.CropText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Badge.Success}">
                            <TextBlock Text="{DynamicResource Badge.Ready}" />
                        </Border>
                        <TextBlock Text="{DynamicResource Calls.OutputsTitle}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Calls.OutputsText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{DynamicResource Calls.NotPlanned}" />
                        </Border>
                        <TextBlock Text="{DynamicResource Calls.AutoDetectTitle}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Calls.AutoDetectText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
