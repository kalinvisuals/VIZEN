<UserControl x:Class="VIZEN.App.Views.OverlaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OverlaysViewModel}"
             d:DesignWidth="1000" d:DesignHeight="760">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Gaming.Title}" Style="{StaticResource Text.PageTitle}" />
                        <Border Style="{StaticResource Badge.Info}" Margin="14,4,0,0"
                                Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SummaryText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Gaming.Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding CloseAllCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{DynamicResource Gaming.CloseAll}">
                        <TextBlock Text="{DynamicResource Gaming.CloseAll}" />
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding BrowseSourcesCommand}"
                            ToolTip="{DynamicResource Gaming.NewOverlayTip}" AutomationProperties.Name="{DynamicResource Gaming.NewOverlay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                            <TextBlock Text="{DynamicResource Gaming.NewOverlay}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Error banner -->
            <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="10"
                    Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="{Binding ErrorMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Unsupported OS -->
            <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource Brush.WarningSoft}" BorderBrush="#40F5B547" BorderThickness="1"
                    Visibility="{Binding IsCaptureSupported, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="{DynamicResource Gaming.Unsupported}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" />
            </Border>

            <!-- Active overlays -->
            <ItemsControl ItemsSource="{Binding Overlays}" Margin="0,22,0,0"
                          Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayViewModel}">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Live thumbnail -->
                                <Border Width="192" Height="108" CornerRadius="10" Background="{DynamicResource Brush.Background}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top">
                                    <Grid>
                                        <views:LivePreview Margin="1" CornerRadius="9" Capture="{Binding Capture}" Viewbox="{Binding Viewbox}" />
                                        <TextBlock Text="{Binding Capture.StatusText}" Style="{StaticResource Text.Caption}"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Capture.HasFrame, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Border>

                                <!-- Details + controls -->
                                <StackPanel Grid.Column="1" Margin="20,2,20,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="15"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse>
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Capture.IsLive}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Capture.StatusText}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" />
                                        <TextBlock Text="{Binding ProcessAndCategory}" Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MaxWidth="260" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Gaming.Opacity}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Slider Grid.Column="1" Style="{StaticResource Slider.Modern}" Minimum="0.15" Maximum="1"
                                                SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity}"
                                                AutomationProperties.Name="Overlay opacity" />
                                        <TextBlock Grid.Column="2" Text="{Binding OpacityText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                                    </Grid>

                                    <WrapPanel Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,28,6" ToolTip="{DynamicResource Gaming.ClickThroughTip}">
                                            <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding IsClickThrough}"
                                                      AutomationProperties.Name="Click-through" />
                                            <TextBlock Text="{DynamicResource Gaming.ClickThrough}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding IsVisible}"
                                                      AutomationProperties.Name="Visible" />
                                            <TextBlock Text="{DynamicResource Gaming.Visible}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="28,0,0,6" ToolTip="{DynamicResource Gaming.ShowPerformanceTip}">
                                            <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding ShowPerformance}"
                                                      AutomationProperties.Name="{DynamicResource Gaming.ShowPerformance}" />
                                            <TextBlock Text="{DynamicResource Gaming.ShowPerformance}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <views:SourceHealthBar DataContext="{Binding Capture}" Margin="0,8,0,0" />
                                    <views:AppAudioBar DataContext="{Binding Audio}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" VerticalAlignment="Top"
                                        Command="{Binding CloseCommand}" AutomationProperties.Name="{DynamicResource Common.Close}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="11" />
                                        <TextBlock Text="{DynamicResource Common.Close}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="40,44"
                    Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                    <Grid Width="140" Height="100" HorizontalAlignment="Center">
                        <Border Width="96" Height="64" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
                        <Border Width="96" Height="64" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" />
                        <Border Width="96" Height="64" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Selection}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81E;" FontSize="20" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{DynamicResource Gaming.EmptyTitle}" Style="{StaticResource Text.Title}" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,26,0,0" />
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,8,0,0" Text="{DynamicResource Gaming.EmptyText}" />
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding BrowseSourcesCommand}"
                            HorizontalAlignment="Center" Margin="0,22,0,0" AutomationProperties.Name="{DynamicResource Gaming.BrowseSources}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F4;" FontSize="12" />
                            <TextBlock Text="{DynamicResource Gaming.BrowseSources}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Usage notes -->
            <TextBlock Text="{DynamicResource Gaming.GoodToKnow}" Style="{StaticResource Text.Overline}" Margin="0,28,0,12" />
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconChip}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7FC;" />
                        </Border>
                        <TextBlock Text="{DynamicResource Gaming.TipGamesTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{DynamicResource Gaming.TipGamesText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconChip}" HorizontalAlignment="Left" Background="{DynamicResource Brush.VioletSoft}"
                                TextElement.Foreground="{DynamicResource Brush.AccentViolet}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7C9;" />
                        </Border>
                        <TextBlock Text="{DynamicResource Gaming.TipMoveTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{DynamicResource Gaming.TipMoveText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource IconChip}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE921;" />
                        </Border>
                        <TextBlock Text="{DynamicResource Gaming.TipMinimizedTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{DynamicResource Gaming.TipMinimizedText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
