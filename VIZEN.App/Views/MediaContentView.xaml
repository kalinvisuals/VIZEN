<UserControl x:Class="VIZEN.App.Views.MediaContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             IsHitTestVisible="False">
    <!-- DataContext: the MediaLayerViewModel whose crop, rotation, volume and mute are applied. -->
    <Viewbox Stretch="Uniform">
        <Grid>
            <Grid.LayoutTransform>
                <RotateTransform Angle="{Binding Rotation}" />
            </Grid.LayoutTransform>
            <views:CropPanel x:Name="Cropper" Crop="{Binding Crop}" Width="16" Height="9">
                <Image x:Name="ContentImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                <MediaElement x:Name="ContentVideo" Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                              ScrubbingEnabled="False" Volume="{Binding Volume}" IsMuted="{Binding Muted}" Visibility="Collapsed" />
            </views:CropPanel>
        </Grid>
    </Viewbox>
</UserControl>
