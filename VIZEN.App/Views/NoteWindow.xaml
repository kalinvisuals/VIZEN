<Window x:Class="VIZEN.App.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NoteViewModel}"
        Title="{Binding WindowTitle}"
        Width="300" Height="260" MinWidth="180" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Foreground="{DynamicResource Brush.TextPrimary}" FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- A WPF-only window: static content, redrawn only when it changes. No capture, no Direct3D presenter. -->
    <Border x:Name="Card" Margin="4" CornerRadius="14" BorderThickness="1"
            Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.BorderStrong}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: drag area (when unlocked), title, state icons, hide -->
            <Grid x:Name="Header" Background="Transparent" Height="34" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="4" Height="16" CornerRadius="2" Margin="12,0,0,0" Background="{DynamicResource Brush.AccentGradientVertical}" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="9,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" Margin="0,0,8,0" VerticalAlignment="Center"
                               Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.TextTertiary}" ToolTip="{DynamicResource Notes.LockedTip}"
                               Visibility="{Binding Locked, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="30" Height="30" MinHeight="0" Padding="0" FontSize="10" Margin="0,0,3,0"
                        Content="&#xE921;" Command="{Binding HideCommand}"
                        ToolTip="{DynamicResource Notes.HideWindow}" AutomationProperties.Name="{DynamicResource Notes.HideWindow}" />
            </Grid>

            <!-- Text note -->
            <TextBox Grid.Row="1" Style="{StaticResource TextBox.Bare}" Margin="8,0,8,10" Padding="6,4"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Notes.TextPlaceholder}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
                     AutomationProperties.AutomationId="NoteText" AutomationProperties.Name="{Binding Title}"
                     Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />

            <!-- Checklist -->
            <Grid Grid.Row="1" Margin="8,0,8,10" Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar Height="3" Margin="6,0,6,6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.SurfaceHover}" BorderThickness="0" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChecklistItemViewModel}">
                                <Grid x:Name="Row" Margin="4,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckBox.Tick}" IsChecked="{Binding Done}" VerticalAlignment="Top" Margin="0,5,0,0"
                                              AutomationProperties.Name="{Binding Text}" />
                                    <TextBox x:Name="ItemText" Grid.Column="1" Style="{StaticResource TextBox.Bare}" Margin="6,0,0,0" Padding="4,3"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource Button.Icon}" Width="24" Height="24" MinHeight="0" Padding="0"
                                            FontSize="9" Content="&#xE711;" Command="{Binding RemoveCommand}" Opacity="0" VerticalAlignment="Top" Margin="2,2,0,0"
                                            ToolTip="{DynamicResource Notes.RemoveItem}" AutomationProperties.Name="{DynamicResource Notes.RemoveItem}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                        <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Remove" Property="Opacity" Value="1" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="4,6,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="4,0,4,0" />
                    <TextBox Grid.Column="1" Style="{StaticResource TextBox.Bare}" Padding="4,4" Margin="4,0,0,0"
                             Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Notes.AddItemPlaceholder}"
                             AutomationProperties.AutomationId="NoteNewItem" AutomationProperties.Name="{DynamicResource Notes.AddItemPlaceholder}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
