<UserControl x:Class="VIZEN.App.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             xmlns:models="clr-namespace:VIZEN.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudioViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <Style x:Key="FeatureRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Studio.Title}" Style="{StaticResource Text.PageTitle}" />
                        <Border Style="{StaticResource Badge.Info}" Margin="14,4,0,0"
                                Visibility="{Binding Outputs.HasOutputs, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock>
                                <Run Text="{Binding Outputs.Count, Mode=OneWay}" /><Run Text="{DynamicResource Studio.OutputsSuffix}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Studio.Subtitle}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Command="{Binding CloseAllOutputsCommand}" VerticalAlignment="Center"
                        Visibility="{Binding Outputs.HasOutputs, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{DynamicResource Gaming.CloseAll}">
                    <TextBlock Text="{DynamicResource Gaming.CloseAll}" />
                </Button>
            </Grid>

            <!-- Error -->
            <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="10"
                    Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding Outputs.ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="{Binding Outputs.ErrorMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ============ Active OBS outputs ============ -->
            <TextBlock Text="{DynamicResource Studio.ActiveOutputs}" Style="{StaticResource Text.Overline}" Margin="0,24,0,12" />
            <ItemsControl ItemsSource="{Binding Outputs.Outputs}"
                          Visibility="{Binding Outputs.HasOutputs, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OutputViewModel}">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail: exactly what OBS sees (background + fit mode) -->
                                <Border Width="192" Height="108" CornerRadius="8" Background="{Binding BackgroundBrush}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top" ClipToBounds="True">
                                    <Rectangle Margin="1" RenderOptions.BitmapScalingMode="Linear">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding Capture.Frame}" Viewbox="{Binding Viewbox}"
                                                        ViewboxUnits="RelativeToBoundingBox" Stretch="{Binding Stretch}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="20,0,16,0">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Capture.StatusText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" />
                                        <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </StackPanel>
                                    <views:SourceHealthBar DataContext="{Binding Capture}" Margin="0,10,0,0" />
                                    <views:AppAudioBar DataContext="{Binding Audio}" Margin="0,4,0,0" />

                                    <!-- Exact title to pick in OBS -->
                                    <TextBlock Text="{DynamicResource Studio.ObsTitleLabel}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding WindowTitle, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource TextBox.Input}"
                                             Height="32" FontFamily="{StaticResource Font.Mono}" FontSize="12" MaxWidth="460" HorizontalAlignment="Left"
                                             ToolTip="{DynamicResource Studio.ObsTitleTip}" AutomationProperties.Name="OBS window title" />

                                    <!-- Size presets -->
                                    <TextBlock Text="{DynamicResource Studio.Size}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource PresetButton}" Command="{Binding SizePresetCommand}" CommandParameter="1:1"
                                                ToolTip="{DynamicResource Studio.Size11Tip}" AutomationProperties.Name="{DynamicResource Studio.Size11}">
                                            <TextBlock Text="{DynamicResource Studio.Size11}" />
                                        </Button>
                                        <Button Style="{StaticResource PresetButton}" Command="{Binding SizePresetCommand}" CommandParameter="50" AutomationProperties.Name="50%">
                                            <TextBlock Text="50%" />
                                        </Button>
                                        <Button Style="{StaticResource PresetButton}" Command="{Binding SizePresetCommand}" CommandParameter="720p" AutomationProperties.Name="1280 × 720">
                                            <TextBlock Text="1280 × 720" />
                                        </Button>
                                        <Button Style="{StaticResource PresetButton}" Command="{Binding SizePresetCommand}" CommandParameter="1080p" AutomationProperties.Name="1920 × 1080">
                                            <TextBlock Text="1920 × 1080" />
                                        </Button>
                                    </WrapPanel>

                                    <!-- Fit + background -->
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border CornerRadius="10" Padding="3" Margin="0,0,12,6"
                                                Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsFit, Mode=TwoWay}"
                                                             Content="{DynamicResource Studio.Fit}" ToolTip="{DynamicResource Studio.FitTip}" />
                                                <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsFill, Mode=TwoWay}"
                                                             Content="{DynamicResource Studio.Fill}" ToolTip="{DynamicResource Studio.FillTip}" />
                                                <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsStretch, Mode=TwoWay}"
                                                             Content="{DynamicResource Studio.Stretch}" ToolTip="{DynamicResource Studio.StretchTip}" />
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="10" Padding="3" Margin="0,0,0,6"
                                                Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsBlackBackground, Mode=TwoWay}"
                                                             Content="{DynamicResource Studio.BgBlack}" />
                                                <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsGreenBackground, Mode=TwoWay}"
                                                             Content="{DynamicResource Studio.BgGreen}" ToolTip="{DynamicResource Studio.BgGreenTip}" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding BringToFrontCommand}" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource Studio.Show}">
                                        <TextBlock Text="{DynamicResource Studio.Show}" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CloseCommand}" AutomationProperties.Name="{DynamicResource Common.Close}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="11" />
                                            <TextBlock Text="{DynamicResource Common.Close}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="28"
                    Visibility="{Binding Outputs.HasOutputs, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE714;" FontSize="26" Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{DynamicResource Studio.NoOutputs}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{DynamicResource Studio.NoOutputsText}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ Compositions ============ -->
            <Grid Margin="0,28,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{DynamicResource Composition.Header}" Style="{StaticResource Text.Overline}" />
                    <TextBlock Text="{DynamicResource Composition.Hint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding Compositions.NewCommand}" VerticalAlignment="Top"
                        AutomationProperties.Name="{DynamicResource Composition.New}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                        <TextBlock Text="{DynamicResource Composition.New}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="10" Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding Compositions.ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Compositions.ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl ItemsSource="{Binding Compositions.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompositionViewModel}">
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Input}" Height="32"
                                                 MinWidth="240" MaxWidth="380" HorizontalAlignment="Left" FontWeight="SemiBold"
                                                 AutomationProperties.Name="{DynamicResource Composition.NameLabel}" />
                                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}">
                                            <Run Text="{Binding CanvasText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBox Text="{Binding WindowTitle, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource TextBox.Input}" Height="30" Margin="0,8,0,0"
                                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" MaxWidth="460" HorizontalAlignment="Left"
                                                 ToolTip="{DynamicResource Studio.ObsTitleTip}" AutomationProperties.Name="OBS window title" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenCommand}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Composition.Open}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="11" Foreground="White" /><TextBlock Text="{DynamicResource Composition.Open}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding CloseCommand}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Common.Close}">
                                                <TextBlock Text="{DynamicResource Common.Close}" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ToggleEditCommand}" Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource Composition.EditTip}" AutomationProperties.Name="{DynamicResource Composition.Edit}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70F;" FontSize="11" /><TextBlock Text="{DynamicResource Composition.Edit}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding DeleteCommand}" ToolTip="{DynamicResource Composition.Delete}" AutomationProperties.Name="{DynamicResource Composition.Delete}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource Composition.ConfirmDelete}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding CancelDeleteCommand}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Common.Cancel}">
                                                <TextBlock Text="{DynamicResource Common.Cancel}" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ConfirmDeleteCommand}" Background="#33E5484D" BorderBrush="#66E5484D"
                                                    AutomationProperties.Name="{DynamicResource Common.Delete}">
                                                <TextBlock Text="{DynamicResource Common.Delete}" Foreground="{DynamicResource Brush.Danger}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Composition.EditingWarning}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" Margin="0,8,0,0"
                                                   HorizontalAlignment="Right" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource Composition.Canvas}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,8" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,8" Command="{Binding CanvasPresetCommand}" CommandParameter="1080p" Content="1920 × 1080" AutomationProperties.Name="1920 x 1080" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,8" Command="{Binding CanvasPresetCommand}" CommandParameter="720p" Content="1280 × 720" AutomationProperties.Name="1280 x 720" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,8" Command="{Binding CanvasPresetCommand}" CommandParameter="vertical" Content="1080 × 1920" AutomationProperties.Name="1080 x 1920" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,22,8" Command="{Binding CanvasPresetCommand}" CommandParameter="square" Content="1080 × 1080" AutomationProperties.Name="1080 x 1080" />
                                    <TextBlock Text="{DynamicResource Composition.WindowSize}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,8" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,8" Command="{Binding WindowSizeCommand}" CommandParameter="canvas"
                                            Content="{DynamicResource Composition.SizeCanvas}" AutomationProperties.Name="{DynamicResource Composition.SizeCanvas}" />
                                    <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,22,8" Command="{Binding WindowSizeCommand}" CommandParameter="half"
                                            Content="50%" AutomationProperties.Name="50%" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                                        <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsBlackBackground, Mode=TwoWay}" Content="{DynamicResource Studio.BgBlack}" />
                                        <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsGreenBackground, Mode=TwoWay}" Content="{DynamicResource Studio.BgGreen}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Background="Transparent" ToolTip="{DynamicResource Composition.AutoOpenTip}">
                                        <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding AutoOpen}" AutomationProperties.Name="{DynamicResource Composition.AutoOpen}" />
                                        <TextBlock Text="{DynamicResource Composition.AutoOpen}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Layers, front first -->
                                <TextBlock Text="{DynamicResource Composition.Layers}" Style="{StaticResource Text.Overline}" Margin="0,8,0,8" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CompositionItemViewModel}">
                                            <Border Padding="12,6" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush.Background}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Background="Transparent" ToolTip="{DynamicResource Composition.FollowTip}"
                                                                    Visibility="{Binding IsMedia, Converter={StaticResource BoolToVisibility}}">
                                                            <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding FollowLayerVisibility}" AutomationProperties.Name="{DynamicResource Composition.Follow}" />
                                                            <TextBlock Text="{DynamicResource Composition.Follow}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                                        </StackPanel>
                                                        <Slider Style="{StaticResource Slider.Modern}" Width="90" Minimum="0.05" Maximum="1" Value="{Binding Opacity}" VerticalAlignment="Center"
                                                                AutomationProperties.Name="{DynamicResource Gaming.Opacity}" ToolTip="{DynamicResource Gaming.Opacity}" />
                                                        <TextBlock Text="{Binding OpacityText}" VerticalAlignment="Center" Margin="8,0,10,0" MinWidth="36" />
                                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding FitAspectCommand}" Padding="8,4" Content="{DynamicResource Media.Fit}"
                                                                ToolTip="{DynamicResource Composition.FitTip}" AutomationProperties.Name="{DynamicResource Media.Fit}" />
                                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding FillCanvasCommand}" Padding="8,4" Content="{DynamicResource Composition.FillCanvas}"
                                                                AutomationProperties.Name="{DynamicResource Composition.FillCanvas}" />
                                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding MoveForwardCommand}" Padding="8,4"
                                                                ToolTip="{DynamicResource Media.ForwardTip}" AutomationProperties.Name="{DynamicResource Media.Forward}">
                                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70E;" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding MoveBackwardCommand}" Padding="8,4"
                                                                ToolTip="{DynamicResource Media.BackwardTip}" AutomationProperties.Name="{DynamicResource Media.Backward}">
                                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding RemoveCommand}" Padding="8,4"
                                                                ToolTip="{DynamicResource Composition.RemoveItem}" AutomationProperties.Name="{DynamicResource Composition.RemoveItem}">
                                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding KindGlyph}" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}" />
                                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BoundsText}" Style="{StaticResource Text.Caption}" Margin="23,2,0,0" />
                                                        <TextBlock Text="{Binding MissingText}" Foreground="{DynamicResource Brush.Warning}" FontSize="12" Margin="23,2,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding MissingText, Converter={StaticResource NullToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource Composition.NoLayers}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                                <!-- Add: open OBS outputs (captures/regions) and media layers -->
                                <TextBlock Text="{DynamicResource Composition.AddCapture}" Style="{StaticResource Text.Caption}" Margin="0,6,0,6" />
                                <ItemsControl ItemsSource="{Binding DataContext.Outputs.Outputs, RelativeSource={RelativeSource AncestorType=UserControl}}" Tag="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:OutputViewModel}">
                                            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,6" CommandParameter="{Binding}"
                                                    Command="{Binding Tag.AddOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat=+ {0}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="10" />
                                                    <TextBlock Text="{Binding DisplayName}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource Composition.NoOutputsToAdd}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"
                                           Visibility="{Binding DataContext.Outputs.HasOutputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <TextBlock Text="{DynamicResource Composition.AddMedia}" Style="{StaticResource Text.Caption}" Margin="0,6,0,6" />
                                <ItemsControl ItemsSource="{Binding AvailableMedia}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MediaLayerViewModel}">
                                            <Button Style="{StaticResource Button.Secondary}" Padding="10,5" Margin="0,0,6,6" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.AddMediaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=+ {0}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding KindGlyph}" FontSize="10" />
                                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="24"
                    Visibility="{Binding Compositions.HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <TextBlock Text="{DynamicResource Composition.Empty}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Detected studio sources -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Studio.Detected}" Style="{StaticResource Text.Title}" />
                            <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Run Text="{Binding WindowCount, Mode=OneWay}" /><Run Text="{DynamicResource Studio.WindowsSuffix}" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{DynamicResource Studio.DetectedCaption}" Style="{StaticResource Text.Caption}" Margin="0,4,0,14" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding StudioWindows}"
                                      Visibility="{Binding HasStudioWindows, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WindowSource}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.SurfaceHover}">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                                <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" />
                                            <TextBlock Text="{Binding ProcessName}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CategoryText}" />
                                            </Border>
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE7A8;" Width="30" Height="30"
                                                    Command="{Binding DataContext.CropCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource Studio.CropTip}" AutomationProperties.Name="{DynamicResource Studio.CropTip}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE714;" Width="30" Height="30"
                                                    Command="{Binding DataContext.CreateOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource Studio.CreateOutputTip}" AutomationProperties.Name="{DynamicResource Studio.CreateOutputTip}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource Studio.NoWindows}" Style="{StaticResource Text.Body}"
                                   Visibility="{Binding HasStudioWindows, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Button.Link}" Command="{Binding ShowInSourcesCommand}" CommandParameter="Browsers" Margin="-10,0,16,0" AutomationProperties.Name="{DynamicResource Studio.ShowBrowsers}">
                                <TextBlock Text="{DynamicResource Studio.ShowBrowsers}" />
                            </Button>
                            <Button Style="{StaticResource Button.Link}" Command="{Binding ShowInSourcesCommand}" CommandParameter="Media" Margin="0,0,16,0" AutomationProperties.Name="{DynamicResource Studio.ShowMedia}">
                                <TextBlock Text="{DynamicResource Studio.ShowMedia}" />
                            </Button>
                            <Button Style="{StaticResource Button.Link}" Command="{Binding ShowInSourcesCommand}" CommandParameter="Cameras" Margin="0" AutomationProperties.Name="{DynamicResource Studio.ShowCameras}">
                                <TextBlock>
                                    <Run Text="{DynamicResource Studio.ShowCameras}" /><Run Text=" (" /><Run Text="{Binding CameraCount, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- OBS setup guide -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Studio.ObsGuideTitle}" Style="{StaticResource Text.Title}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Studio.ObsStep1}" Style="{StaticResource Text.Body}" Margin="10,0,0,10" />
                                <Border Grid.Row="1" Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Studio.ObsStep2}" Style="{StaticResource Text.Body}" Margin="10,0,0,10" />
                                <Border Grid.Row="2" Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Studio.ObsStep3}" Style="{StaticResource Text.Body}" Margin="10,0,0,10" />
                                <Border Grid.Row="3" Style="{StaticResource StepNumber}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Studio.ObsStep4}" Style="{StaticResource Text.Body}" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Studio.ObsTestedNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Feature status -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Studio.FeatureStatus}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{DynamicResource Studio.FeatureStatusCaption}" Style="{StaticResource Text.Caption}" Margin="0,4,0,18" />

                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureDiscovery}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureCapture}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureCrop}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureObs}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureWebcam}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource FeatureRow}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureExtension}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Studio.FeatureAudio}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Style="{StaticResource Badge.Success}"><TextBlock Text="{DynamicResource Badge.Ready}" /></Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
