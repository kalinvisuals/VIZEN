<UserControl x:Class="VIZEN.App.Views.AppAudioBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding Converter={StaticResource NullToVisibility}}">
    <!-- DataContext: an AppAudioViewModel (null for cameras: the control hides). -->
    <StackPanel>
        <WrapPanel>
            <Button Style="{StaticResource Button.Ghost}" Command="{Binding ToggleMuteCommand}" Padding="8,4" Margin="0,0,8,6"
                    ToolTip="{DynamicResource Audio.MuteTip}" AutomationProperties.Name="{DynamicResource Audio.Mute}">
                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding MuteGlyph}" FontSize="14" />
            </Button>
            <!-- Level meter -->
            <Border Width="90" Height="8" CornerRadius="4" Background="{DynamicResource Brush.SurfaceHover}" VerticalAlignment="Center" Margin="0,0,12,6"
                    ToolTip="{DynamicResource Audio.MeterTip}" ClipToBounds="True">
                <Border HorizontalAlignment="Left" Width="90" CornerRadius="4" Background="{DynamicResource Brush.Success}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Peak}" />
                    </Border.RenderTransform>
                </Border>
            </Border>
            <Slider Style="{StaticResource Slider.Modern}" Width="130" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                    Value="{Binding VolumePercent}" VerticalAlignment="Center" Margin="0,0,8,6" IsEnabled="{Binding HasAudio}"
                    AutomationProperties.Name="{DynamicResource Audio.Volume}" ToolTip="{DynamicResource Audio.VolumeTip}" />
            <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="40" Margin="0,0,10,6" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,0,6" />
        </WrapPanel>
        <WrapPanel Visibility="{Binding IsListenSupported, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6" Background="Transparent" ToolTip="{DynamicResource Audio.ListenTip}">
                <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding IsListening}" AutomationProperties.Name="{DynamicResource Audio.Listen}" />
                <TextBlock Text="{DynamicResource Audio.Listen}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Center" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"
                                     GroupName="{Binding DataContext.GroupId, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     AutomationProperties.Name="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ListenStatus}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Margin="10,0,0,6"
                       Visibility="{Binding ListenStatus, Converter={StaticResource NullToVisibility}}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
