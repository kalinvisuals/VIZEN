<UserControl x:Class="VIZEN.App.Views.WindowSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             xmlns:models="clr-namespace:VIZEN.App.Models"
             xmlns:svc="clr-namespace:VIZEN.App.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowSourcesViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Category chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="17" Padding="12,7" Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,4,36,28" Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock Text="{DynamicResource Sources.Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Sources.Subtitle}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource TextBox.Search}" Tag="{DynamicResource Sources.SearchPlaceholder}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="{Binding LastRefreshedText}" Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Grid.Column="4" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" AutomationProperties.Name="{DynamicResource Common.Refresh}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="12" />
                    <TextBlock Text="{DynamicResource Common.Refresh}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Category chips -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryFilter}">
                    <RadioButton Style="{StaticResource Chip}" GroupName="SourceCategory" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="12" />
                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" FontWeight="SemiBold" />
                            <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,0" Background="{DynamicResource Brush.SurfaceHover}">
                                <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Browser limitation note -->
        <Border Grid.Row="3" Margin="0,2,0,12" Padding="12,8" CornerRadius="10"
                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="#404C8DFF" BorderThickness="1"
                Visibility="{Binding ShowBrowserNote, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Text="{DynamicResource Sources.BrowserNote}" Margin="10,0,0,0" TextWrapping="Wrap" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="4" Margin="0,0,0,12" Padding="14,10" CornerRadius="10"
                Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Danger}" />
                <TextBlock Text="{Binding ErrorMessage}" Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Source list -->
            <ListBox Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Card}"
                     ItemsSource="{Binding SourcesView}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:WindowSource}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brush.SurfaceHover}">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
                                    <TextBlock Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" />
                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge.Info}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding CategoryGlyph}" FontSize="10" />
                                        <TextBlock Text="{Binding CategoryText}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding StateText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Scanning state (first scan only) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBusy}" Value="True" />
                                    <Condition Binding="{Binding TotalCount}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="26" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{DynamicResource Sources.ScanningLong}" Margin="0,12,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F4;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
                </Border>
                <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Camera detection problems (cameras themselves are listed above as sources) -->
            <Border Grid.Row="1" Margin="0,4,6,0" Padding="12,8" CornerRadius="10"
                    Background="{DynamicResource Brush.WarningSoft}" BorderBrush="#40F5B547" BorderThickness="1"
                    Visibility="{Binding CameraError, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding CameraError}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Warning}" />
            </Border>

            <!-- Browser tabs (VIZEN Connector extension), filtered like the windows above -->
            <Border Grid.Row="2" Margin="0,12,6,0" Padding="16,12" CornerRadius="16" BorderThickness="1"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    Visibility="{Binding ShowTabsSection, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xEA86;" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{DynamicResource Tabs.SectionTitle}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VisibleTabs.Count, StringFormat=({0})}" Margin="6,0,0,0" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                                   Visibility="{Binding IsTabsConnected, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Not connected: how to connect -->
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsTabsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Tabs.SectionHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Style="{StaticResource Mixer.PillButton}" Height="32" Command="{Binding ConnectBrowserCommand}"
                                Content="{DynamicResource Tabs.SectionConnect}" AutomationProperties.Name="{DynamicResource Tabs.SectionConnect}" />
                    </Grid>

                    <!-- Connected: the tabs -->
                    <TextBlock Text="{DynamicResource Tabs.SectionEmpty}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ShowTabsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" Focusable="False"
                                  Visibility="{Binding IsTabsConnected, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding VisibleTabs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.SurfaceHover}" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{DynamicResource Tabs.Playing}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Success}"
                                                           Visibility="{Binding Audible, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Mixer.IconButton}" Width="32" Height="32" Margin="0,0,6,0" Command="{Binding ActivateCommand}"
                                                    ToolTip="{DynamicResource Tabs.ActivateTip}" AutomationProperties.Name="{DynamicResource Tabs.Activate}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8AB;" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource Mixer.IconButton}" Width="32" Height="32" Margin="0,0,6,0" Tag="{Binding Muted}" Command="{Binding ToggleMuteCommand}"
                                                    ToolTip="{DynamicResource Tabs.MuteTip}" AutomationProperties.Name="{Binding MuteName}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding MuteGlyph}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource Mixer.IconButton}" Width="32" Height="32" Command="{Binding PopOutCommand}"
                                                    ToolTip="{DynamicResource Tabs.PopOutTip}" AutomationProperties.Name="{DynamicResource Tabs.PopOut}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Details panel -->
            <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <!-- Nothing selected -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="26" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Text="{DynamicResource Sources.SelectWindow}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="{DynamicResource Sources.SelectWindowHint}"
                                   Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Selected source -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="22,22,22,8" DataContext="{Binding SelectedSource}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="13" Background="{DynamicResource Brush.SurfaceHover}" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" TextWrapping="Wrap"
                                                   MaxHeight="66" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessSummary}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Live preview (Windows Graphics Capture) -->
                                <Border Height="168" Margin="0,20,0,14" CornerRadius="12" Background="{DynamicResource Brush.Background}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <Grid>
                                        <views:LivePreview Margin="1" CornerRadius="11"
                                                           Lease="{Binding DataContext.PreviewLease, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Capture="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                                    Visibility="{Binding DataContext.HasPreviewFrame, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7B3;" FontSize="20"
                                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                                            <TextBlock Text="{Binding DataContext.PreviewMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Status under the video (nothing can be drawn over the native video) -->
                                <Border Style="{StaticResource Badge.Success}" Margin="0,-6,0,12" HorizontalAlignment="Left"
                                        Visibility="{Binding DataContext.HasPreviewFrame, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DataContext.Preview.StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>

                                <!-- Minimized-source recovery actions -->
                                <views:SourceHealthBar Margin="0,-6,0,10"
                                                       DataContext="{Binding DataContext.Preview, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <views:AppAudioBar Margin="0,0,0,10"
                                                   DataContext="{Binding DataContext.SelectedAudio, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                <!-- Idle browser window hint -->
                                <Border Padding="10,8" CornerRadius="8" Margin="0,-6,0,14"
                                        Background="{DynamicResource Brush.WarningSoft}" BorderBrush="#40F5B547" BorderThickness="1"
                                        Visibility="{Binding DataContext.ShowIdleBrowserHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource Sources.IdleBrowserHint}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Brush.Warning}" />
                                </Border>

                                <!-- Category -->
                                <TextBlock Text="{DynamicResource Details.Category}" Style="{StaticResource DetailLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding CategoryGlyph}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="{Binding CategoryText}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Sources.CategoryFromTab}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Visibility="{Binding IsCategoryFromTabTitle, Converter={StaticResource BoolToVisibility}}" />
                                <Border Height="14" />

                                <TextBlock Text="{DynamicResource Details.Executable}" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding ExecutablePathText}" Style="{StaticResource DetailValue}" FontSize="12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Details.Size}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Text="{DynamicResource Details.State}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Text="{DynamicResource Details.Handle}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding HandleText}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Details.Position}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Text="{DynamicResource Details.Dpi}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding DpiText}" Style="{StaticResource DetailValue}" />
                                        <TextBlock Text="{DynamicResource Details.ProcessId}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding ProcessId}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Details.Class}" Style="{StaticResource DetailLabel}" />
                                <TextBlock Text="{Binding ClassName}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Style="{StaticResource Button.Secondary}" Command="{Binding EditRegionsCommand}" Padding="10,9"
                                        ToolTip="{DynamicResource Sources.RegionsTip}" AutomationProperties.Name="{DynamicResource Sources.Regions}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7A8;" FontSize="12" />
                                        <TextBlock Text="{DynamicResource Sources.Regions}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding CreateOutputCommand}" Padding="10,9"
                                        ToolTip="{DynamicResource Sources.OutputTip}" AutomationProperties.Name="{DynamicResource Sources.Output}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE714;" FontSize="12" />
                                        <TextBlock Text="{DynamicResource Sources.Output}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Style="{StaticResource Button.Secondary}" Command="{Binding CopyDetailsCommand}" Padding="10,9" AutomationProperties.Name="{DynamicResource Sources.CopyDetails}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="{DynamicResource Sources.CopyDetails}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding CreateOverlayCommand}" Padding="10,9"
                                        ToolTip="{DynamicResource Sources.CreateOverlayTip}" AutomationProperties.Name="{DynamicResource Common.CreateOverlay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                                        <TextBlock Text="{DynamicResource Common.CreateOverlay}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
