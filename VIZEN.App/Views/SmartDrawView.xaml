<UserControl x:Class="VIZEN.App.Views.SmartDrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:m="clr-namespace:VIZEN.App.Models"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SmartDrawViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <sys:Boolean x:Key="BoolTrue">True</sys:Boolean>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Margin" Value="0,4,10,4" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="150" />
        </Style>
        <Style x:Key="Choice" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{StaticResource BoolTrue}">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Draw.Title}" Style="{StaticResource Text.PageTitle}" />
                <Border Style="{StaticResource Badge.Info}" Margin="14,4,0,0">
                    <TextBlock Text="{Binding SummaryText}" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Draw.Subtitle}" TextWrapping="Wrap" MaxWidth="880" HorizontalAlignment="Left" />

            <!-- On / off and modes -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Draw.EnableTitle}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{DynamicResource Draw.EnableDescription}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource Draw.EnableTitle}" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding IsEnabled}">
                        <Button Style="{StaticResource Action}" Command="{Binding DrawModeCommand}" AutomationProperties.Name="{DynamicResource Draw.DrawModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70F;" FontSize="12" />
                                <TextBlock Text="{DynamicResource Draw.DrawModeButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Action}" Command="{Binding PassThroughCommand}" AutomationProperties.Name="{DynamicResource Draw.PassThroughModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7C9;" FontSize="12" />
                                <TextBlock Text="{DynamicResource Draw.PassThroughModeButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Action}" Command="{Binding ToggleVisibilityCommand}" Content="{DynamicResource Draw.ShowHide}"
                                AutomationProperties.Name="{DynamicResource Draw.ShowHide}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource Action}" Command="{Binding UndoCommand}" Content="{DynamicResource Draw.Undo}" AutomationProperties.Name="{DynamicResource Draw.Undo}" />
                        <Button Style="{StaticResource Action}" Command="{Binding RedoCommand}" Content="{DynamicResource Draw.Redo}" AutomationProperties.Name="{DynamicResource Draw.Redo}" />
                        <Button Style="{StaticResource Action}" Command="{Binding ClearCommand}" Content="{DynamicResource Draw.Clear}" AutomationProperties.Name="{DynamicResource Draw.Clear}"
                                Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{DynamicResource Draw.ClearConfirm}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Danger}" />
                            <Button Style="{StaticResource Action}" Command="{Binding ConfirmClearCommand}" Background="#33E5484D" BorderBrush="#66E5484D"
                                    AutomationProperties.Name="{DynamicResource Draw.ClearYes}">
                                <TextBlock Text="{DynamicResource Draw.ClearYes}" Foreground="{DynamicResource Brush.Danger}" />
                            </Button>
                            <Button Style="{StaticResource Action}" Command="{Binding CancelClearCommand}" Content="{DynamicResource Common.Cancel}" AutomationProperties.Name="{DynamicResource Common.Cancel}" />
                        </StackPanel>
                        <Button Style="{StaticResource Action}" Command="{Binding SaveCommand}" Content="{DynamicResource Draw.SaveButton}" AutomationProperties.Name="{DynamicResource Draw.SaveButton}" />
                        <Button Style="{StaticResource Action}" Command="{Binding RestoreCommand}" Content="{DynamicResource Draw.RestoreButton}" AutomationProperties.Name="{DynamicResource Draw.RestoreButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Tool defaults -->
            <TextBlock Text="{DynamicResource Draw.Defaults}" Style="{StaticResource Text.Overline}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Draw.ToolLabel}" Style="{StaticResource Label}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Pen}" ToolTip="{DynamicResource Draw.Tool.Pen}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Pen}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Pen}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Arrow}" ToolTip="{DynamicResource Draw.Tool.Arrow}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Arrow}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Arrow}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Rectangle}" ToolTip="{DynamicResource Draw.Tool.Rectangle}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Rectangle}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Rectangle}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Ellipse}" ToolTip="{DynamicResource Draw.Tool.Ellipse}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Ellipse}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Ellipse}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Text}" ToolTip="{DynamicResource Draw.Tool.Text}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Text}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Text}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Short.Eraser}" ToolTip="{DynamicResource Draw.Tool.Eraser}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static m:DrawTool.Eraser}"
                                Tag="{Binding Tool, Converter={StaticResource EnumEquals}, ConverterParameter=Eraser}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Draw.Color}" Style="{StaticResource Label}" />
                        <ItemsControl ItemsSource="{x:Static vm:SmartDrawViewModel.Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DrawColor}">
                                    <Button Style="{StaticResource Button.Icon}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="0,0,4,0" CommandParameter="{Binding Hex}"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                        <Ellipse Width="20" Height="20" Fill="{Binding Hex}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Ellipse Width="26" Height="26" Margin="10,0,0,0" Fill="{Binding Color}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                                 ToolTip="{DynamicResource Draw.CurrentColor}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Draw.Thickness}" Style="{StaticResource Label}" />
                        <Button Style="{StaticResource Choice}" Command="{Binding NextThicknessCommand}" AutomationProperties.Name="{DynamicResource Draw.Thickness}">
                            <TextBlock>
                                <Run Text="{Binding Thickness, Mode=OneWay}" /><Run Text=" px" />
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{DynamicResource Draw.TextSize}" Style="{StaticResource Label}" Margin="24,0,0,0" />
                        <Button Style="{StaticResource Choice}" Command="{Binding NextFontSizeCommand}" AutomationProperties.Name="{DynamicResource Draw.TextSize}">
                            <TextBlock>
                                <Run Text="{Binding FontSize, Mode=OneWay}" /><Run Text=" px" />
                            </TextBlock>
                        </Button>
                        <TextBlock Text="{DynamicResource Draw.ArrowHead}" Style="{StaticResource Label}" Margin="24,0,0,0" />
                        <Button Style="{StaticResource Choice}" Command="{Binding ToggleArrowHeadCommand}" Content="{Binding ArrowHeadText}" AutomationProperties.Name="{DynamicResource Draw.ArrowHead}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Draw.EraserMode}" Style="{StaticResource Label}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Eraser.Precision}" Command="{Binding SetEraserModeCommand}"
                                CommandParameter="{x:Static m:EraserMode.Precision}" Tag="{Binding EraserMode, Converter={StaticResource EnumEquals}, ConverterParameter=Precision}" />
                        <Button Style="{StaticResource Choice}" Content="{DynamicResource Draw.Eraser.Object}" Command="{Binding SetEraserModeCommand}"
                                CommandParameter="{x:Static m:EraserMode.Object}" Tag="{Binding EraserMode, Converter={StaticResource EnumEquals}, ConverterParameter=Object}" />
                        <TextBlock Text="{DynamicResource Draw.EraserSize}" Style="{StaticResource Label}" Margin="24,0,0,0" />
                        <Slider Style="{StaticResource Slider.Modern}" Width="160" Minimum="5" Maximum="100" SmallChange="1" LargeChange="10"
                                Value="{Binding EraserSize}" AutomationProperties.Name="{DynamicResource Draw.EraserSize}" />
                        <TextBlock Text="{Binding EraserSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Draw.EraserNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="150,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Draw.Opacity}" Style="{StaticResource Label}" />
                        <Slider Style="{StaticResource Slider.Modern}" Width="180" Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Opacity}" AutomationProperties.Name="{DynamicResource Draw.Opacity}" />
                        <TextBlock Text="{Binding OpacityText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- How to, shortcuts, limits -->
            <TextBlock Text="{DynamicResource Draw.HowToTitle}" Style="{StaticResource Text.Overline}" Margin="0,26,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Draw.HowTo}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20" />
                    <TextBlock Text="{DynamicResource Draw.HotkeyHint}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20" />
                    <TextBlock Text="{DynamicResource Draw.Limits}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Text.Caption}" LineHeight="18" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="2,10,0,0" TextWrapping="Wrap">
                <Run Text="{DynamicResource Draw.StoredIn}" />
                <Run Text="{Binding StorageLocation, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
