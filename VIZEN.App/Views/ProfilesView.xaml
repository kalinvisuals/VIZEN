<UserControl x:Class="VIZEN.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
             d:DesignWidth="1000" d:DesignHeight="760">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Profiles.Title}" Style="{StaticResource Text.PageTitle}" />
                <Border Style="{StaticResource Badge.Info}" Margin="14,4,0,0"
                        Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock>
                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text="{DynamicResource Profiles.SavedSuffix}" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{DynamicResource Profiles.Subtitle}" />

            <!-- Save current layout -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{DynamicResource Profiles.SaveCurrent}" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding SaveHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource TextBox.Input}" Width="240" Tag="{DynamicResource Profiles.NamePlaceholder}"
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                                 AutomationProperties.Name="Profile name">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveCurrentCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SaveCurrentCommand}" Margin="10,0,0,0" AutomationProperties.Name="{DynamicResource Profiles.SaveButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74E;" FontSize="12" Foreground="White" />
                                <TextBlock Text="{DynamicResource Profiles.SaveButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status / error banners -->
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="#40FF354E" BorderThickness="1"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                    Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Saved profiles -->
            <TextBlock Text="{DynamicResource Profiles.SavedHeader}" Style="{StaticResource Text.Overline}" Margin="0,26,0,12" />
            <ItemsControl ItemsSource="{Binding Profiles}"
                          Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChip}" Width="40" Height="40" CornerRadius="11" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SourcesText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Normal actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding DeleteCommand}" Margin="0,0,6,0"
                                            ToolTip="{DynamicResource Profiles.DeleteTip}" AutomationProperties.Name="{DynamicResource Profiles.DeleteTip}">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding UpdateCommand}" Margin="0,0,8,0"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{DynamicResource Profiles.UpdateTip}" AutomationProperties.Name="{DynamicResource Profiles.Update}">
                                        <TextBlock Text="{DynamicResource Profiles.Update}" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}"
                                            ToolTip="{DynamicResource Profiles.ApplyTip}" AutomationProperties.Name="{DynamicResource Profiles.Apply}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="11" Foreground="White" />
                                            <TextBlock Text="{DynamicResource Profiles.Apply}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Delete confirmation -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource Profiles.ConfirmDelete}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding CancelDeleteCommand}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Common.Cancel}">
                                        <TextBlock Text="{DynamicResource Common.Cancel}" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ConfirmDeleteCommand}"
                                            Background="#33E5484D" BorderBrush="#66E5484D" AutomationProperties.Name="{DynamicResource Common.Delete}">
                                        <TextBlock Text="{DynamicResource Common.Delete}" Foreground="{DynamicResource Brush.Danger}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="40,40"
                    Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Profiles.EmptyTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" Text="{DynamicResource Profiles.EmptyText}" />
                </StackPanel>
            </Border>

            <!-- How it works -->
            <TextBlock Text="{DynamicResource Profiles.HowHeader}" Style="{StaticResource Text.Overline}" Margin="0,28,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{DynamicResource Profiles.HowText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap">
                        <Run Text="{DynamicResource Profiles.StoredAt}" />
                        <Run Text="{Binding StorageLocation, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
