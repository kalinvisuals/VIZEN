<Window x:Class="VIZEN.App.Views.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
        xmlns:views="clr-namespace:VIZEN.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AudioMixerViewModel}"
        Title="VIZEN Smart Audio Mixer"
        Width="360" SizeToContent="Height" MinWidth="260" MinHeight="180" MaxHeight="900" MaxWidth="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Foreground="{DynamicResource Brush.Mx.Text}" FontFamily="{StaticResource Font.UI}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Resizable from its edges (6 px) and from the grip in the bottom-right corner. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- A WPF-only window: no capture, no Direct3D; redrawn when a level, volume or row changes. -->
    <Grid>
    <Border Margin="4" CornerRadius="24" BorderThickness="1" Padding="16,8,16,14"
            Background="{DynamicResource Brush.Mx.Bg}" BorderBrush="{DynamicResource Brush.Mx.LineStrong}">
        <DockPanel>
            <!-- Header: drag area, label, live count, hide -->
            <Grid DockPanel.Dock="Top" Height="40" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Mixer.FloatingTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Brush.Mx.Line}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PlayingCount}" FontFamily="{StaticResource Mixer.Mono}" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Mx.Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="9" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.AccentSoft}"
                            ToolTip="{Binding Focus.StatusText}" Visibility="{Binding Focus.IsDucking, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource Focus.LoweredChip}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Mixer.IconButton}" Width="28" Height="28" Command="{Binding HideFloatingCommand}"
                        ToolTip="{DynamicResource Mixer.Close}" AutomationProperties.Name="{DynamicResource Mixer.Close}">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="9" />
                </Button>
            </Grid>

            <!-- Profiles: segmented control, one click applies -->
            <ScrollViewer DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <Border Style="{StaticResource Mixer.SegmentBar}">
                    <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AudioProfileViewModel}">
                                <Button Style="{StaticResource Mixer.Segment}" Height="28" Padding="11,0" FontSize="11" Tag="{Binding IsSelected}"
                                        Command="{Binding ApplyCommand}" ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Name}"
                                        Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
            <Border DockPanel.Dock="Bottom" Height="1" Margin="0,8,0,0" Background="{DynamicResource Brush.Mx.Line}" />

            <!-- Windows volume (master), live -->
            <Grid DockPanel.Dock="Top" Margin="0,4,0,6" Visibility="{Binding HasMaster, Converter={StaticResource BoolToVisibility}}" ToolTip="{DynamicResource Mixer.MasterTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Width="32" Height="32" Margin="0,0,10,0" CornerRadius="10" Background="{DynamicResource Brush.Mx.Invert}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F3;" FontSize="13" Foreground="{DynamicResource Brush.Mx.InvertText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{DynamicResource Mixer.Master}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,-2" />
                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource Mixer.Volume}" Height="26" Margin="-11,0,0,0" Focusable="False" views:FaderWheel.IsEnabled="True"
                        Value="{Binding MasterVolumePercent}" Tag="{Binding MasterPeak}" AutomationProperties.Name="{DynamicResource Mixer.MasterVolumeName}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MasterVolumePercent, StringFormat={}{0:0}%}" FontFamily="{StaticResource Mixer.Mono}" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Mx.Muted}" />
                <Button Grid.RowSpan="2" Grid.Column="3" Style="{StaticResource Mixer.IconButton}" Width="32" Height="32" Margin="10,0,0,0"
                        Tag="{Binding MasterMuted}" Command="{Binding ToggleMasterMuteCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource Mixer.MasterMuteName}">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding MasterMuteGlyph}" FontSize="12" />
                </Button>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Margin="0,2,0,4" Background="{DynamicResource Brush.Mx.Line}"
                    Visibility="{Binding HasMaster, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state -->
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Mixer.FloatingEmpty}" Margin="0,6,0,4" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Mx.Muted}"
                       Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <!-- Apps -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource Mixer.RowCompact}" Focusable="False" />
            </ScrollViewer>
        </DockPanel>
    </Border>
    <!-- Resize grip (drag to make the mixer smaller or bigger; double-click the header for the automatic size) -->
    <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Background="Transparent"
          Cursor="SizeNWSE" WindowChrome.ResizeGripDirection="BottomRight" ToolTip="{DynamicResource Mixer.ResizeTip}">
        <Path Data="M16,6 L6,16 M16,11 L11,16" Stroke="{DynamicResource Brush.Mx.Faint}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Grid>
    </Grid>
</Window>
