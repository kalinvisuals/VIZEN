<UserControl x:Class="VIZEN.App.Views.SchedulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SchedulesViewModel}"
             d:DesignWidth="1000" d:DesignHeight="800">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource TextBox.Input}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,22,10" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="36,4,36,36" Style="{StaticResource Page.Root}">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Schedule.Title}" Style="{StaticResource Text.PageTitle}" />
                <Border Style="{StaticResource Badge.Info}" Margin="14,4,0,0">
                    <TextBlock Text="{Binding SummaryText}" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{DynamicResource Schedule.Subtitle}" />

            <!-- Create -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Schedule.CreateHeader}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{DynamicResource Schedule.CreateHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding StopAllCommand}" Margin="0,0,10,0"
                                    AutomationProperties.Name="{DynamicResource Schedule.StopAll}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71A;" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Schedule.StopAll}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding NewScheduleCommand}"
                                    AutomationProperties.Name="{DynamicResource Schedule.New}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Foreground="White" />
                                    <TextBlock Text="{DynamicResource Schedule.New}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Sponsor playlists from media groups -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding Library.HasGroups, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource Schedule.FromGroup}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Library.Groups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.NewFromGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.Name="{Binding StringFormat=Playlist {0}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F1;" FontSize="11" />
                                            <TextBlock Text="{Binding}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                    Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- Schedules -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
                        <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Header: name, status, run controls -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Input}" Height="32"
                                                 MinWidth="240" MaxWidth="380" HorizontalAlignment="Left" FontWeight="SemiBold"
                                                 AutomationProperties.Name="{DynamicResource Schedule.NameLabel}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextTertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                            <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" Margin="0,0,6,0"
                                                    AutomationProperties.Name="{DynamicResource Schedule.Start}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="11" Foreground="White" /><TextBlock Text="{DynamicResource Schedule.Start}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding PauseCommand}" Margin="0,0,6,0"
                                                    AutomationProperties.Name="{DynamicResource Schedule.Pause}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE769;" FontSize="11" /><TextBlock Text="{DynamicResource Schedule.Pause}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding StopCommand}" Margin="0,0,6,0"
                                                    AutomationProperties.Name="{DynamicResource Schedule.Stop}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71A;" FontSize="11" /><TextBlock Text="{DynamicResource Schedule.Stop}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding TriggerCommand}" Margin="0,0,6,0"
                                                    ToolTip="{DynamicResource Schedule.TriggerTip}" AutomationProperties.Name="{DynamicResource Schedule.Trigger}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE945;" FontSize="11" /><TextBlock Text="{DynamicResource Schedule.Trigger}" Margin="6,0,0,0" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding DeleteCommand}"
                                                    ToolTip="{DynamicResource Schedule.Delete}" AutomationProperties.Name="{DynamicResource Schedule.Delete}">
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource Schedule.ConfirmDelete}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding CancelDeleteCommand}" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource Common.Cancel}">
                                                <TextBlock Text="{DynamicResource Common.Cancel}" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ConfirmDeleteCommand}"
                                                    Background="#33E5484D" BorderBrush="#66E5484D" AutomationProperties.Name="{DynamicResource Common.Delete}">
                                                <TextBlock Text="{DynamicResource Common.Delete}" Foreground="{DynamicResource Brush.Danger}" />
                                            </Button>
                                        </StackPanel>
                                        <Button Style="{StaticResource Button.Link}" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                                Content="{DynamicResource Schedule.ShowSettings}" AutomationProperties.Name="{DynamicResource Schedule.ShowSettings}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                                    <!-- Mode and order -->
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource Field}">
                                            <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsPermanent, Mode=TwoWay}"
                                                         Content="{DynamicResource Schedule.ModePermanent}" ToolTip="{DynamicResource Schedule.ModePermanentTip}" />
                                            <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsOnce, Mode=TwoWay}"
                                                         Content="{DynamicResource Schedule.ModeOnce}" ToolTip="{DynamicResource Schedule.ModeOnceTip}" />
                                            <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsRepeat, Mode=TwoWay}"
                                                         Content="{DynamicResource Schedule.ModeRepeat}" ToolTip="{DynamicResource Schedule.ModeRepeatTip}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}">
                                            <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsSequential, Mode=TwoWay}"
                                                         Content="{DynamicResource Schedule.OrderSequential}" />
                                            <RadioButton Style="{StaticResource RadioButton.Segment}" IsChecked="{Binding IsRandom, Mode=TwoWay}"
                                                         Content="{DynamicResource Schedule.OrderRandom}" ToolTip="{DynamicResource Schedule.OrderRandomTip}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Timing -->
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource Field}" ToolTip="{DynamicResource Schedule.VisibleTip}">
                                            <TextBlock Text="{DynamicResource Schedule.Visible}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding VisibleSecondsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}"
                                                     AutomationProperties.Name="{DynamicResource Schedule.Visible}" />
                                            <TextBlock Text="s" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource Schedule.Every}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding IntervalMinutesText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}"
                                                     AutomationProperties.Name="{DynamicResource Schedule.Every}" />
                                            <TextBlock Text="{DynamicResource Schedule.Minutes}" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Text="{DynamicResource Schedule.Delay}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding StartDelayText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}"
                                                     AutomationProperties.Name="{DynamicResource Schedule.Delay}" />
                                            <TextBlock Text="s" Style="{StaticResource FieldLabel}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}" ToolTip="{DynamicResource Schedule.WindowTip}">
                                            <TextBlock Text="{DynamicResource Schedule.ActiveFrom}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ActiveFrom, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Tag="hh:mm"
                                                     AutomationProperties.Name="{DynamicResource Schedule.ActiveFrom}" />
                                            <TextBlock Text="{DynamicResource Schedule.ActiveUntil}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ActiveUntil, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Tag="hh:mm"
                                                     AutomationProperties.Name="{DynamicResource Schedule.ActiveUntil}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Hotkey and auto-start -->
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Text="{DynamicResource Schedule.Hotkey}" Style="{StaticResource FieldLabel}" />
                                            <views:HotkeyBox Gesture="{Binding Hotkey}" Style="{StaticResource TextBox.Input}" Width="190" Height="30"
                                                             FontFamily="{StaticResource Font.Mono}" FontSize="12" ToolTip="{DynamicResource Schedule.HotkeyTip}"
                                                             AutomationProperties.Name="{DynamicResource Schedule.Hotkey}" />
                                            <TextBlock Text="{Binding HotkeyStatusText}" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource Field}" Background="Transparent" ToolTip="{DynamicResource Schedule.AutoStartTip}">
                                            <CheckBox Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding AutoStart}" AutomationProperties.Name="{DynamicResource Schedule.AutoStart}" />
                                            <TextBlock Text="{DynamicResource Schedule.AutoStart}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- Layers -->
                                    <TextBlock Text="{DynamicResource Schedule.LayersHeader}" Style="{StaticResource Text.Overline}" Margin="0,8,0,8" />
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScheduleEntryViewModel}">
                                                <Border Padding="12,6" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Brush.Background}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource Schedule.OwnDuration}" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding SecondsText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NumberBox}" Tag="auto"
                                                                     ToolTip="{DynamicResource Schedule.OwnDurationTip}" AutomationProperties.Name="{DynamicResource Schedule.OwnDuration}" />
                                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding MoveUpCommand}" Padding="8,4"
                                                                    ToolTip="{DynamicResource Schedule.MoveUp}" AutomationProperties.Name="{DynamicResource Schedule.MoveUp}">
                                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70E;" FontSize="11" />
                                                            </Button>
                                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding MoveDownCommand}" Padding="8,4"
                                                                    ToolTip="{DynamicResource Schedule.MoveDown}" AutomationProperties.Name="{DynamicResource Schedule.MoveDown}">
                                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE70D;" FontSize="11" />
                                                            </Button>
                                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding RemoveCommand}" Padding="8,4"
                                                                    ToolTip="{DynamicResource Schedule.RemoveLayer}" AutomationProperties.Name="{DynamicResource Schedule.RemoveLayer}">
                                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE711;" FontSize="11" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding KindGlyph}" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}" />
                                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{DynamicResource Schedule.NoLayers}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                                               Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                                    <TextBlock Text="{DynamicResource Schedule.AddLayer}" Style="{StaticResource Text.Caption}" Margin="0,6,0,6" />
                                    <ItemsControl ItemsSource="{Binding AvailableLayers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MediaLayerViewModel}">
                                                <Button Style="{StaticResource SmallButton}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.AddLayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=+ {0}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="10" />
                                                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Preview -->
                                    <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource Brush.SurfaceRaised}"
                                            Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Schedule.PreviewHeader}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding PreviewLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Padding="40,40"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE823;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Border>
                    <TextBlock Text="{DynamicResource Schedule.EmptyTitle}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" Text="{DynamicResource Schedule.EmptyText}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,18,0,0" TextWrapping="Wrap">
                <Run Text="{DynamicResource Media.StoredAt}" />
                <Run Text="{Binding StorageLocation, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
