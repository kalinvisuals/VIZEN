<UserControl x:Class="VIZEN.App.Views.RegionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RegionEditorViewModel}"
             d:DesignWidth="1100" d:DesignHeight="760">

    <Grid Margin="36,4,36,28" Style="{StaticResource Page.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource Button.Icon}" Content="&#xE72B;" Command="{Binding BackCommand}"
                    ToolTip="{DynamicResource Common.Back}" AutomationProperties.Name="{DynamicResource Common.Back}" VerticalAlignment="Top" Margin="-8,2,8,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource Editor.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Source.Title}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="{DynamicResource Editor.Subtitle}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,10"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="#40FF354E" BorderThickness="1"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,10"
                    Background="#1FE5484D" BorderBrush="#40E5484D" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="{Binding ErrorMessage}" Margin="10,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Editor -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Canvas -->
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="10" Background="{DynamicResource Brush.Background}" ClipToBounds="True">
                        <Grid>
                            <views:RegionCanvas Frame="{Binding Frame}" Regions="{Binding Regions}"
                                                SelectedRegion="{Binding SelectedRegion, Mode=TwoWay}"
                                                AddRegionCommand="{Binding AddRegionCommand}"
                                                CommitCommand="{Binding CommitCommand}"
                                                DeleteCommand="{Binding DeleteRegionCommand}"
                                                AutomationProperties.Name="Region canvas" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"
                                        Visibility="{Binding Capture.HasFrame, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7B3;" FontSize="22" Foreground="{DynamicResource Brush.TextTertiary}" />
                                <TextBlock Text="{Binding Capture.StatusText}" Margin="0,10,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="4,12,4,2">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE7C9;" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <TextBlock Text="{DynamicResource Editor.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="10,0,0,0" />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Side panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="18,16,14,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Editor.Regions}" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding RegionCountText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddDefaultRegionCommand}" HorizontalAlignment="Right"
                                Padding="12,6" MinHeight="32" AutomationProperties.Name="{DynamicResource Editor.AddRegion}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="11" />
                                <TextBlock Text="{DynamicResource Editor.AddRegion}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Region list -->
                    <Grid Grid.Row="1">
                        <ListBox Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Card}" Padding="14,0,8,0"
                                 ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CropRegionViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Live thumbnail: the source frame cropped on the GPU via Viewbox -->
                                        <Border Width="96" Height="54" CornerRadius="6" Background="{DynamicResource Brush.Background}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Rectangle Margin="1" RenderOptions.BitmapScalingMode="Linear">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding Frame}" Viewbox="{Binding Bounds}"
                                                                ViewboxUnits="RelativeToBoundingBox" Stretch="Uniform" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Input}"
                                                     Height="30" FontWeight="SemiBold" MaxLength="40"
                                                     ToolTip="{DynamicResource Editor.RenameTip}" AutomationProperties.Name="Region name" />
                                            <TextBlock Text="{Binding PixelSizeText}" Style="{StaticResource Text.Caption}" Margin="2,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE81E;" Width="30" Height="28"
                                                    Command="{Binding DataContext.OpenOverlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource Editor.OpenOverlayTip}" AutomationProperties.Name="{DynamicResource Editor.OpenOverlayTip}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE714;" Width="30" Height="28"
                                                    Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{DynamicResource Editor.OpenOutputTip}" AutomationProperties.Name="{DynamicResource Editor.OpenOutputTip}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding HasRegions, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7A8;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
                            <TextBlock Text="{DynamicResource Editor.NoRegions}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="{DynamicResource Editor.NoRegionsHint}" Style="{StaticResource Text.Body}" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Selected region -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,14"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Editor.Aspect}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6" />
                            <Border CornerRadius="10" Padding="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <ListBox ItemsSource="{Binding AspectOptions}" SelectedItem="{Binding SelectedAspect, Mode=TwoWay}"
                                         Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Segment}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Aspect ratio">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AspectOption}">
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding DeleteRegionCommand}" HorizontalAlignment="Left"
                                    Margin="-8,10,0,0" Padding="8,6" MinHeight="0" AutomationProperties.Name="{DynamicResource Editor.DeleteRegion}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource Brush.Danger}" />
                                    <TextBlock Text="{DynamicResource Editor.DeleteRegion}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Danger}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Outputs -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,14">
                        <StackPanel>
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenAllCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Editor.OpenAll}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81E;" FontSize="12" Foreground="White" />
                                    <TextBlock Text="{DynamicResource Editor.OpenAll}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenAllOutputsCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    ToolTip="{DynamicResource Editor.ObsTip}" AutomationProperties.Name="{DynamicResource Editor.ObsOutput}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE714;" FontSize="12" />
                                    <TextBlock Text="{DynamicResource Editor.ObsOutput}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
