<UserControl x:Class="VIZEN.App.Views.AudioMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioMixerViewModel}"
             d:DesignWidth="1100" d:DesignHeight="1000"
             Foreground="{DynamicResource Brush.Mx.Text}">

    <UserControl.Resources>
        <!-- Panel: hairline border, large radius, no shadow -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Mx.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mx.Line}" />
        </Style>
        <!-- Small uppercase monospace label above each section -->
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mixer.Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mx.Muted}" />
            <Setter Property="Margin" Value="6,36,0,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Mx.Faint}" />
        </Style>
        <!-- Faint square grid backdrop -->
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Viewbox="0,0,44,44" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource Brush.Mx.Grid}" Geometry="M0,0 L44,0 L44,1 L0,1 Z M0,0 L1,0 L1,44 L0,44 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid>
            <!-- Backdrop: grid and a soft light at the top, behind everything -->
            <!-- Accent light from the top edge, fading down (follows the theme's accent colour) -->
            <Rectangle Height="640" VerticalAlignment="Top" Fill="{DynamicResource Brush.Mx.AccentFade}" IsHitTestVisible="False" CacheMode="BitmapCache" />
            <Ellipse Width="760" Height="420" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-260,0,0"
                     Fill="{DynamicResource Brush.Mx.AccentGlow}" IsHitTestVisible="False" CacheMode="BitmapCache" />
            <Rectangle Height="1" Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="{DynamicResource Brush.Mx.AccentLine}" IsHitTestVisible="False" />
            <Rectangle Height="420" VerticalAlignment="Top" Fill="{StaticResource GridBrush}" IsHitTestVisible="False" CacheMode="BitmapCache">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <StackPanel Margin="40,44,40,48" MaxWidth="980" Style="{StaticResource Page.Root}">

                <!-- ============ Header ============ -->
                <TextBlock Text="{DynamicResource Mixer.Eyebrow}" FontFamily="{StaticResource Mixer.Mono}" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Mx.Muted}" />
                <TextBlock Text="{DynamicResource Mixer.Title}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="{DynamicResource Mixer.Tagline}" FontSize="16" LineHeight="24" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="640"
                           TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Mx.Muted}" />

                <!-- Status bar, shaped like a chat composer: live counts on the left, actions on the right -->
                <Border CornerRadius="30" BorderThickness="1" Padding="22,9,9,9" Margin="0,30,0,0" MaxWidth="760"
                        Background="{DynamicResource Brush.Mx.Panel}" BorderBrush="{DynamicResource Brush.Mx.LineStrong}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PlayingText}" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="·" Margin="10,0" FontSize="14" Foreground="{DynamicResource Brush.Mx.Faint}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SummaryText}" FontSize="14" Foreground="{DynamicResource Brush.Mx.Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Mixer.IconButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                                    ToolTip="{DynamicResource Mixer.RefreshTip}" AutomationProperties.Name="{DynamicResource Mixer.Refresh}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource Mixer.PillButton}" Tag="{StaticResource Mixer.True}" Command="{Binding ToggleFloatingCommand}"
                                    ToolTip="{DynamicResource Mixer.FloatingHint}" AutomationProperties.Name="{Binding FloatingButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FloatingButtonText}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{DynamicResource Mixer.HotkeyHint}" Style="{StaticResource Hint}" Margin="0,12,0,0" TextAlignment="Center" MaxWidth="720" />
                <Border CornerRadius="22" BorderThickness="1" Padding="20,6,20,6" Margin="0,14,0,0" MaxWidth="760"
                        Background="{DynamicResource Brush.Mx.Panel}" BorderBrush="{DynamicResource Brush.Mx.Line}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Mixer.Opacity}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,18,0"
                                   ToolTip="{DynamicResource Mixer.OpacityTip}" />
                        <Slider Grid.Column="1" Style="{StaticResource Mixer.Volume}" Minimum="30" Maximum="100" Tag="0"
                                Value="{Binding FloatingOpacityPercent}" VerticalAlignment="Center"
                                ToolTip="{DynamicResource Mixer.OpacityTip}" AutomationProperties.Name="{DynamicResource Mixer.Opacity}" />
                        <TextBlock Grid.Column="2" Text="{Binding FloatingOpacityPercent, StringFormat={}{0:0}%}" FontFamily="{StaticResource Mixer.Mono}" FontSize="13"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                <!-- ============ Apps ============ -->
                <TextBlock Text="{DynamicResource Mixer.AppsEyebrow}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource Panel}" Padding="24,10">
                    <StackPanel>
                        <!-- Windows volume: the master volume of the default output device, live -->
                        <Grid Margin="0,10" Visibility="{Binding HasMaster, Converter={StaticResource BoolToVisibility}}" ToolTip="{DynamicResource Mixer.MasterTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="00" FontFamily="{StaticResource Mixer.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Faint}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Brush.Mx.Invert}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F3;" FontSize="16" Foreground="{DynamicResource Brush.Mx.InvertText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="14,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Mixer.Master}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MasterName}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource Brush.Mx.Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Slider x:Name="MasterVolume" Grid.Column="3" Style="{StaticResource Mixer.Volume}" Value="{Binding MasterVolumePercent}" Tag="{Binding MasterPeak}"
                                    VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Mixer.MasterVolumeName}" />
                            <TextBlock Grid.Column="4" Text="{Binding MasterVolumePercent, StringFormat={}{0:0}%}" FontFamily="{StaticResource Mixer.Mono}" FontSize="13"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Style="{StaticResource Mixer.IconButton}" Tag="{Binding MasterMuted}" Command="{Binding ToggleMasterMuteCommand}"
                                    Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Mixer.MasterMuteName}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding MasterMuteGlyph}" FontSize="14" />
                            </Button>
                        </Grid>
                        <Border Height="1" Margin="0,4" Background="{DynamicResource Brush.Mx.Line}" Visibility="{Binding HasMaster, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Apps -->
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource Mixer.Row}" AlternationCount="1000" Focusable="False" />
                        <StackPanel HorizontalAlignment="Center" Margin="0,22,0,18"
                                    Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE767;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Mx.Muted}" />
                            <TextBlock Text="{DynamicResource Mixer.Empty}" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Mx.Muted}" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="520" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource Mixer.SharedNote}" Style="{StaticResource Hint}" Margin="6,12,0,0" />

                <!-- ============ Profiles ============ -->
                <TextBlock Text="{DynamicResource Mixer.ProfilesEyebrow}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource Panel}" Padding="24,22">
                    <StackPanel>
                        <!-- Segmented control: click a profile to apply it -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" views:WheelPassthrough.IsEnabled="True">
                            <Border Style="{StaticResource Mixer.SegmentBar}">
                                <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AudioProfileViewModel}">
                                            <Button Style="{StaticResource Mixer.Segment}" Tag="{Binding IsSelected}" Command="{Binding ApplyCommand}"
                                                    ToolTip="{DynamicResource Mixer.ProfileApplyTip}" AutomationProperties.Name="{Binding Name}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <!-- Selected profile: what it holds, how the current mix relates to it, actions -->
                        <Grid Margin="4,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="18" FontWeight="SemiBold" />
                                    <Border CornerRadius="10" Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.Mx.Invert}"
                                            Visibility="{Binding SelectedProfile.IsActive, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <TextBlock Text="{DynamicResource Mixer.ProfileActive}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Mx.InvertText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedStateText}" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                <TextBlock Text="{Binding SelectedProfile.Summary}" Margin="0,8,0,0" FontFamily="{StaticResource Mixer.Mono}" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Faint}"
                                           Visibility="{Binding SelectedProfile.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedProfile.IsConfirmingDelete, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Visible}">
                                <Button Style="{StaticResource Mixer.IconButton}" Command="{Binding SelectedProfile.DeleteCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding SelectedProfile.IsCustom, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                        ToolTip="{DynamicResource Mixer.ProfileDelete}" AutomationProperties.Name="{DynamicResource Mixer.ProfileDelete}">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE74D;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource Mixer.PillButton}" Tag="{StaticResource Mixer.True}" Command="{Binding SelectedProfile.SaveCommand}"
                                        ToolTip="{DynamicResource Mixer.ProfileSaveTip}" AutomationProperties.Name="{DynamicResource Mixer.ProfileSave}"
                                        Content="{DynamicResource Mixer.ProfileSave}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding SelectedProfile.IsConfirmingDelete, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <TextBlock Text="{DynamicResource Mixer.ProfileConfirmDelete}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                <Button Style="{StaticResource Mixer.PillButton}" Command="{Binding SelectedProfile.CancelDeleteCommand}" Margin="0,0,8,0"
                                        Content="{DynamicResource Common.Cancel}" AutomationProperties.Name="{DynamicResource Common.Cancel}" />
                                <Button Style="{StaticResource Mixer.PillButton}" Tag="{StaticResource Mixer.True}" Command="{Binding SelectedProfile.ConfirmDeleteCommand}"
                                        Content="{DynamicResource Mixer.ProfileDeleteConfirm}" AutomationProperties.Name="{DynamicResource Mixer.ProfileDeleteConfirm}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,22,0,18" Background="{DynamicResource Brush.Mx.Line}" />

                        <!-- New profile: composer-style input with a round white button -->
                        <Border CornerRadius="26" BorderThickness="1" Padding="18,6,6,6"
                                Background="{DynamicResource Brush.Mx.Bg}" BorderBrush="{DynamicResource Brush.Mx.LineStrong}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Mixer.Input}" Height="38"
                                         Foreground="{DynamicResource Brush.Mx.Text}" CaretBrush="{DynamicResource Brush.Mx.Text}"
                                         Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Mixer.NewProfilePlaceholder}"
                                         AutomationProperties.Name="{DynamicResource Mixer.NewProfilePlaceholder}" />
                                <Button Grid.Column="1" Style="{StaticResource Mixer.PillButton}" Tag="{StaticResource Mixer.True}" Command="{Binding CreateProfileCommand}"
                                        AutomationProperties.Name="{DynamicResource Mixer.NewProfile}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Mixer.NewProfile}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource Mixer.ProfilesHint}" Style="{StaticResource Hint}" Margin="6,12,0,0" />

                <!-- ============ Smart Audio Focus ============ -->
                <TextBlock Text="{DynamicResource Focus.Eyebrow}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource Panel}" Padding="26,24" DataContext="{Binding Focus}">
                    <StackPanel>
                        <!-- Header: icon, title, what it does, on / off -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="14" VerticalAlignment="Top" Background="{DynamicResource Brush.Mx.Invert}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F3;" FontSize="18" Foreground="{DynamicResource Brush.Mx.InvertText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                <TextBlock Text="{DynamicResource Focus.Title}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Focus.Description}" FontSize="13" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Mx.Muted}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource CheckBox.Toggle}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Top" Margin="0,4,0,0"
                                      AutomationProperties.Name="{DynamicResource Focus.Title}" />
                        </Grid>

                        <!-- Diagram: priority app  →  apps that get quieter (lights up while lowering) -->
                        <Border CornerRadius="20" BorderThickness="1" Padding="20,18" Margin="0,22,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Mx.Raised}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mx.Line}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDucking}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Priority app with its live level and the threshold marker -->
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.PriorityEyebrow}" FontFamily="{StaticResource Mixer.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Width="44" Height="44" CornerRadius="13" BorderThickness="1" Background="{DynamicResource Brush.Mx.Panel}" BorderBrush="{DynamicResource Brush.Mx.Line}">
                                            <Grid>
                                                <Image Source="{Binding PriorityIcon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasPriorityIcon, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F5;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Mx.Muted}"
                                                           Visibility="{Binding HasPriorityIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding PriorityName}" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Height="16" Margin="0,14,8,0" ToolTip="{DynamicResource Focus.LevelTip}">
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource Brush.Mx.Line}" />
                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource Brush.Success}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding PriorityLevel}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ThresholdLeft}" />
                                                <ColumnDefinition Width="{Binding ThresholdRight}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Width="2" CornerRadius="1" HorizontalAlignment="Left" Background="{DynamicResource Brush.Mx.Text}" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Focus.LevelCaption}" FontSize="11" Margin="0,6,8,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                </StackPanel>

                                <!-- Arrow with the depth -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0">
                                    <Border Width="46" Height="46" CornerRadius="23" BorderThickness="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource Brush.Mx.Panel}" BorderBrush="{DynamicResource Brush.Mx.LineStrong}">
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72A;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding DuckShortText}" FontFamily="{StaticResource Mixer.Mono}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Apps that get quieter: overlapping icons -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Focus.AffectedEyebrow}" FontFamily="{StaticResource Mixer.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <ItemsControl ItemsSource="{Binding AffectedPreview}" Margin="0,12,0,0" Height="44" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FocusAppPreview}">
                                                <Border Width="44" Height="44" CornerRadius="13" BorderThickness="2" Margin="0,0,-10,0" ToolTip="{Binding Name}"
                                                        Background="{DynamicResource Brush.Mx.Panel}" BorderBrush="{DynamicResource Brush.Mx.Raised}">
                                                    <Grid>
                                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F5;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Mx.Muted}"
                                                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding AffectedText}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live status and restore -->
                        <Grid Margin="4,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Mx.Faint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDucking}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="12,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource Brush.Mx.Muted}" />
                            <Button Grid.Column="2" Style="{StaticResource Mixer.PillButton}" Height="34" Command="{Binding RestoreCommand}"
                                    ToolTip="{DynamicResource Focus.RestoreTip}" AutomationProperties.Name="{DynamicResource Focus.Restore}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE777;" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Focus.Restore}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 1 + 2: choices, side by side -->
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="18" BorderThickness="1" Padding="18,16" Background="{DynamicResource Brush.Mx.Raised}" BorderBrush="{DynamicResource Brush.Mx.Line}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="01" FontFamily="{StaticResource Mixer.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Faint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Focus.PriorityLabel}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.PriorityHint}" FontSize="12" LineHeight="18" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                    <ItemsControl ItemsSource="{Binding PriorityChoices}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FocusChoiceViewModel}">
                                                <Button x:Name="Pill" Style="{StaticResource Mixer.PillButton}" Height="34" Margin="0,0,8,8" Tag="{Binding IsSelected}"
                                                        Command="{Binding ToggleCommand}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                        <Setter TargetName="Pill" Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{DynamicResource Focus.NoApps}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Muted}"
                                               Visibility="{Binding HasChoices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="18" BorderThickness="1" Padding="18,16" Background="{DynamicResource Brush.Mx.Raised}" BorderBrush="{DynamicResource Brush.Mx.Line}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="02" FontFamily="{StaticResource Mixer.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Faint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Focus.DuckLabel}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.DuckHint}" FontSize="12" LineHeight="18" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource Mixer.PillButton}" Height="34" Margin="0,0,8,8" Tag="{Binding AllOthers}" Command="{Binding AllOthersCommand}"
                                                Content="{DynamicResource Focus.AllOthers}" AutomationProperties.Name="{DynamicResource Focus.AllOthers}" />
                                        <ItemsControl ItemsSource="{Binding DuckChoices}" Focusable="False"
                                                      Visibility="{Binding IsChoosingApps, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FocusChoiceViewModel}">
                                                    <Button x:Name="Pill" Style="{StaticResource Mixer.PillButton}" Height="34" Margin="0,0,8,8" Tag="{Binding IsSelected}"
                                                            Command="{Binding ToggleCommand}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                            <Setter TargetName="Pill" Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3: how it reacts, in plain words; exact timings under "Advanced" -->
                        <StackPanel Orientation="Horizontal" Margin="4,24,0,12">
                            <TextBlock Text="03" FontFamily="{StaticResource Mixer.Mono}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Faint}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Focus.TuneLabel}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="Tile" TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="18,14,18,10" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Mx.Raised}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mx.Line}" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- How much quieter -->
                            <Border Style="{StaticResource Tile}" ToolTip="{DynamicResource Focus.DuckTip}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.Duck}" FontSize="13" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <TextBlock Text="{Binding DuckText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <Slider Style="{StaticResource Mixer.Volume}" Margin="-11,0" Minimum="10" Maximum="100" Tag="0" Value="{Binding DuckPercent}"
                                            AutomationProperties.Name="{DynamicResource Focus.Duck}" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="{DynamicResource Focus.DuckLess}" FontSize="11" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                        <TextBlock Text="{DynamicResource Focus.DuckMore}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- When it starts -->
                            <Border Grid.Column="2" Style="{StaticResource Tile}" ToolTip="{DynamicResource Focus.SensitivityTip}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.Sensitivity}" FontSize="13" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <TextBlock Text="{Binding SensitivityText}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    <Slider Style="{StaticResource Mixer.Volume}" Margin="-11,0" Minimum="1" Maximum="100" Tag="0" Value="{Binding Sensitivity}"
                                            AutomationProperties.Name="{DynamicResource Focus.Sensitivity}" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="{DynamicResource Focus.SensitivityLow}" FontSize="11" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                        <TextBlock Text="{DynamicResource Focus.SensitivityHigh}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Mx.Faint}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- How fast it comes back: three choices -->
                        <Grid Margin="4,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Focus.Speed}" FontSize="13" Foreground="{DynamicResource Brush.Mx.Muted}" VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="{DynamicResource Focus.SpeedTip}" />
                            <Border Grid.Column="1" Style="{StaticResource Mixer.SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Mixer.Segment}" Tag="{Binding IsQuick}" Command="{Binding SetReactionCommand}" CommandParameter="0"
                                            Content="{DynamicResource Focus.SpeedQuick}" ToolTip="{DynamicResource Focus.SpeedQuickTip}" AutomationProperties.Name="{DynamicResource Focus.SpeedQuick}" />
                                    <Button Style="{StaticResource Mixer.Segment}" Tag="{Binding IsNormal}" Command="{Binding SetReactionCommand}" CommandParameter="1"
                                            Content="{DynamicResource Focus.SpeedNormal}" ToolTip="{DynamicResource Focus.SpeedNormalTip}" AutomationProperties.Name="{DynamicResource Focus.SpeedNormal}" />
                                    <Button Style="{StaticResource Mixer.Segment}" Tag="{Binding IsSmooth}" Command="{Binding SetReactionCommand}" CommandParameter="2"
                                            Content="{DynamicResource Focus.SpeedSmooth}" ToolTip="{DynamicResource Focus.SpeedSmoothTip}" AutomationProperties.Name="{DynamicResource Focus.SpeedSmooth}" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource Mixer.PillButton}" Height="32" Tag="{Binding ShowAdvanced}" Command="{Binding ToggleAdvancedCommand}"
                                    Content="{DynamicResource Focus.Advanced}" ToolTip="{DynamicResource Focus.AdvancedTip}" AutomationProperties.Name="{DynamicResource Focus.Advanced}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Focus.CustomSpeed}" FontSize="12" Margin="4,8,0,0" Foreground="{DynamicResource Brush.Mx.Faint}"
                                   Visibility="{Binding IsCustomReaction, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Advanced: the exact timings -->
                        <UniformGrid Columns="3" Margin="0,14,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
                            <UniformGrid.Resources>
                                <Style x:Key="SmallTile" TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="16,12,16,8" />
                                    <Setter Property="Margin" Value="0,0,12,0" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Mx.Raised}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Mx.Line}" />
                                </Style>
                            </UniformGrid.Resources>
                            <Border Style="{StaticResource SmallTile}" ToolTip="{DynamicResource Focus.AttackTip}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.Attack}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <TextBlock Text="{Binding AttackMs, StringFormat={}{0:0} ms}" FontFamily="{StaticResource Mixer.Mono}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <Slider Style="{StaticResource Mixer.Volume}" Margin="-11,0" Minimum="50" Maximum="2000" SmallChange="50" LargeChange="250" Tag="0"
                                            Value="{Binding AttackMs}" AutomationProperties.Name="{DynamicResource Focus.Attack}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SmallTile}" ToolTip="{DynamicResource Focus.HoldTip}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.Hold}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <TextBlock Text="{Binding HoldMs, StringFormat={}{0:0} ms}" FontFamily="{StaticResource Mixer.Mono}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <Slider Style="{StaticResource Mixer.Volume}" Margin="-11,0" Minimum="0" Maximum="5000" SmallChange="100" LargeChange="500" Tag="0"
                                            Value="{Binding HoldMs}" AutomationProperties.Name="{DynamicResource Focus.Hold}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SmallTile}" ToolTip="{DynamicResource Focus.ReleaseTip}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Focus.Release}" FontSize="12" Foreground="{DynamicResource Brush.Mx.Muted}" />
                                    <TextBlock Text="{Binding ReleaseMs, StringFormat={}{0:0} ms}" FontFamily="{StaticResource Mixer.Mono}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <Slider Style="{StaticResource Mixer.Volume}" Margin="-11,0" Minimum="100" Maximum="5000" SmallChange="100" LargeChange="500" Tag="0"
                                            Value="{Binding ReleaseMs}" AutomationProperties.Name="{DynamicResource Focus.Release}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource Focus.Note}" Style="{StaticResource Hint}" Margin="6,12,0,0" />

                <!-- ============ Limits ============ -->
                <TextBlock Text="{DynamicResource Mixer.LimitsEyebrow}" Style="{StaticResource Eyebrow}" />
                <Border Style="{StaticResource Panel}" Padding="26,20">
                    <TextBlock Text="{DynamicResource Mixer.Limits}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Mx.Muted}" LineHeight="22" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
