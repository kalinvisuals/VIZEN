<Application x:Class="VIZEN.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VIZEN.App.ViewModels"
             xmlns:views="clr-namespace:VIZEN.App.Views"
             xmlns:conv="clr-namespace:VIZEN.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Logo.xaml" />
                <ResourceDictionary Source="Themes/Mixer.xaml" />
                <!-- English is always loaded as the fallback; Loc.Apply merges another language on top. -->
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <conv:AtLeastConverter x:Key="AtLeast" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />

            <!-- View model → view mapping used by the shell's ContentControl -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WindowSourcesViewModel}">
                <views:WindowSourcesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverlaysViewModel}">
                <views:OverlaysView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegionEditorViewModel}">
                <views:RegionEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CallsViewModel}">
                <views:CallsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StudioViewModel}">
                <views:StudioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <views:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MediaLibraryViewModel}">
                <views:MediaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NotesViewModel}">
                <views:NotesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SmartDrawViewModel}">
                <views:SmartDrawView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioMixerViewModel}">
                <views:AudioMixerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SchedulesViewModel}">
                <views:SchedulesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BrowserSourcesViewModel}">
                <views:BrowserView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
                <views:PerformanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
