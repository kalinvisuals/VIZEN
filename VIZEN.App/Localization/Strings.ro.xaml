    <sys:String x:Key="Perf.Estimate">ESTIMARE</sys:String>
    <sys:String x:Key="Perf.TierNote">Se bazează doar pe specificațiile hardware. Rezultatele reale depind de joc, de surse și de drivere, așa că măsurătorile de mai sus sunt cele care contează.</sys:String>
