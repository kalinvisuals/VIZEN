    <sys:String x:Key="Notes.Title">Smart Notes</sys:String>
    <sys:String x:Key="Notes.Subtitle">Notițe text și liste de bifat care plutesc pe desktop și peste jocurile fără margini. Pot rămâne mereu deasupra, pot fi făcute transparente și pot folosi click-through, ca să nu te încurce niciodată. Totul se salvează automat pe acest PC.</sys:String>
