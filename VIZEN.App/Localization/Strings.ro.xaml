    <sys:String x:Key="Sources.Title">Surse</sys:String>
    <sys:String x:Key="Sources.Subtitle">Ferestrele deschise pe acest PC, grupate pe tipuri și actualizate automat. Selectează una ca să vezi o previzualizare live, apoi transform-o în overlay.</sys:String>
