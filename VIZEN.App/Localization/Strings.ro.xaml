    <sys:String x:Key="Perf.NoCaptures">Nu se capturează nimic. Pornește un overlay sau o ieșire OBS ori deschide o previzualizare în Surse.</sys:String>
    <sys:String x:Key="Perf.Col.Source">FPS sursă</sys:String>
    <sys:String x:Key="Perf.Col.Shown">FPS afișat</sys:String>
