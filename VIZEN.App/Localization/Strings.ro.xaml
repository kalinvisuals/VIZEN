    <sys:String x:Key="Sources.EmptyTitle">Nicio fereastră găsită</sys:String>
    <sys:String x:Key="Sources.EmptyMessage">Nu a fost găsită nicio fereastră vizibilă. Deschide o aplicație, apoi reîmprospătează lista.</sys:String>
    <sys:String x:Key="Sources.EmptyFilteredTitle">Nicio fereastră potrivită</sys:String>
    <sys:String x:Key="Sources.EmptyFilteredMessage">Nicio fereastră nu corespunde acestei categorii sau căutări. Încearcă altă categorie sau alt termen de căutare.</sys:String>
    <sys:String x:Key="Sources.EnumerationFailed">Enumerarea ferestrelor a eșuat: {0}</sys:String>
    <sys:String x:Key="Sources.ClipboardBusy">Clipboard-ul este folosit de altă aplicație. Încearcă din nou.</sys:String>
    <sys:String x:Key="Sources.BrowserNote">VIZEN vede ferestrele browserului, nu taburile individuale. Este vizibil doar titlul tabului activ, așa că o fereastră de browser poate trece între Browsere, Apeluri și Media când schimbi tabul. Ca să folosești separat un singur tab, un player YouTube sau un chat live, deschide-l în pagina Browser: devine o sursă separată.</sys:String>
    <sys:String x:Key="Sources.CameraError">Detectarea camerelor a eșuat: {0}</sys:String>
    <sys:String x:Key="Sources.SelectWindow">Selectează o fereastră</sys:String>
    <sys:String x:Key="Sources.SelectWindowHint">Selectează o sursă din listă ca să vezi previzualizarea live și detaliile ei.</sys:String>
    <sys:String x:Key="Sources.CategoryFromTab">Detectat după titlul tabului activ, deci se poate schimba când schimbi tabul.</sys:String>
    <sys:String x:Key="Sources.CopyDetails">Copiază</sys:String>
    <sys:String x:Key="Sources.CreateOverlayTip">Deschide un overlay live al acestei ferestre, mereu deasupra.</sys:String>

    <!-- Gaming -->
    <sys:String x:Key="Gaming.Title">Modul Gaming</sys:String>
    <sys:String x:Key="Gaming.Summary">{0} active · {1} captură(i)</sys:String>
    <sys:String x:Key="Gaming.Subtitle">Ferestre mereu deasupra care oglindesc live o sursă peste joc. Modificările se aplică imediat.</sys:String>
    <sys:String x:Key="Gaming.CloseAll">Închide toate</sys:String>
    <sys:String x:Key="Gaming.NewOverlay">Overlay nou</sys:String>
    <sys:String x:Key="Gaming.NewOverlayTip">Alege o fereastră în Surse, apoi apasă Creează overlay.</sys:String>
    <sys:String x:Key="Gaming.Unsupported">Windows Graphics Capture nu este disponibil pe acest sistem, deci nu se pot crea overlay-uri.</sys:String>
    <sys:String x:Key="Gaming.Opacity">Opacitate</sys:String>
    <sys:String x:Key="Gaming.ClickThrough">Click-through</sys:String>
    <sys:String x:Key="Gaming.ClickThroughTip">Clicurile trec prin overlay către fereastra de dedesubt. Oprește-l aici (sau apasă Ctrl+Shift+F9) ca să-l poți muta sau redimensiona.</sys:String>
    <sys:String x:Key="Gaming.Visible">Vizibil</sys:String>
    <sys:String x:Key="Gaming.EmptyTitle">Niciun overlay activ</sys:String>
    <sys:String x:Key="Gaming.EmptyText">Alege o fereastră în Surse și apasă Creează overlay. Overlay-ul apare deasupra tuturor ferestrelor și o oglindește live.</sys:String>
    <sys:String x:Key="Gaming.BrowseSources">Vezi sursele</sys:String>
    <sys:String x:Key="Gaming.GoodToKnow">BINE DE ȘTIUT</sys:String>
    <sys:String x:Key="Gaming.TipGamesTitle">Jocuri în fereastră și fără margini</sys:String>
    <sys:String x:Key="Gaming.TipGamesText">Overlay-urile apar peste jocurile în fereastră și în ecran complet fără margini (de ex. Euro Truck Simulator 2 în modul borderless). Ecranul complet exclusiv desenează peste toate ferestrele, așa că acolo overlay-urile nu se văd. VIZEN nu atinge niciodată procesul jocului.</sys:String>
    <sys:String x:Key="Gaming.TipMoveTitle">Mută, redimensionează, potrivește</sys:String>
    <sys:String x:Key="Gaming.TipMoveText">Trage ca să muți, trage de margini ca să redimensionezi, dublu-clic ca să elimini benzile negre. Ctrl+Shift+F9 comută click-through, Ctrl+Shift+F10 arată/ascunde toate.</sys:String>
    <sys:String x:Key="Gaming.TipMinimizedTitle">Sursele minimizate se opresc</sys:String>
    <sys:String x:Key="Gaming.TipMinimizedText">Windows nu mai desenează ferestrele minimizate, așa că overlay-ul îngheață până restaurezi sursa. Ferestrele acoperite de alte ferestre continuă să se actualizeze (verificat și cu Chrome/Edge). Cu „Păstrează sursa activă”, VIZEN readuce automat sursa minimizată în spatele ferestrei active.</sys:String>
    <sys:String x:Key="Overlay.Close">Închide overlay-ul</sys:String>

    <!-- Apeluri -->
    <sys:String x:Key="Calls.Title">Modul Apeluri</sys:String>
    <sys:String x:Key="Calls.Subtitle">Ferestrele de apel video din Discord, Zoom, Teams, WhatsApp, Skype și apelurile din browser (Google Meet, Messenger și altele) sunt detectate automat. Oglindește întregul apel într-un singur overlay sau decupează fiecare participant într-un overlay separat.</sys:String>
    <sys:String x:Key="Calls.Detected">FERESTRE DE APEL DETECTATE</sys:String>
    <sys:String x:Key="Calls.ShowInSources">Arată în Surse</sys:String>
    <sys:String x:Key="Calls.InBrowser">tab de browser</sys:String>
    <sys:String x:Key="Calls.MirrorAsOverlay">Oglindește ca overlay</sys:String>
    <sys:String x:Key="Calls.OverlayTip">Deschide fereastra de apel întreagă ca overlay live (modul Gaming).</sys:String>
    <sys:String x:Key="Calls.EmptyTitle">Nicio fereastră de apel acum</sys:String>
    <sys:String x:Key="Calls.EmptyText">Pornește un apel sau intră într-unul în Discord, Zoom, Teams, WhatsApp sau în browser. Apelul apare aici automat în câteva secunde.</sys:String>
    <sys:String x:Key="Calls.Planned">CE FACE ACEST MOD</sys:String>
    <sys:String x:Key="Calls.Milestone4">Milestone 4</sys:String>
    <sys:String x:Key="Calls.Milestone7">Milestone 7</sys:String>
    <sys:String x:Key="Calls.NotPlanned">Nepromis</sys:String>
    <sys:String x:Key="Calls.CropTitle">Decupare interactivă pe regiuni</sys:String>
    <sys:String x:Key="Calls.CropText">Disponibil acum: desenează dreptunghiuri pe apel ca să izolezi participanții. Poți face mai multe decupaje pe aceeași fereastră, fiecare cu previzualizare live și overlay propriu.</sys:String>
    <sys:String x:Key="Calls.OutputsTitle">Ieșiri independente per participant</sys:String>
    <sys:String x:Key="Calls.OutputsText">Disponibil acum: din editorul de regiuni, deschide fiecare decupaj ca overlay separat sau ca fereastră de ieșire OBS curată.</sys:String>
    <sys:String x:Key="Calls.AutoDetectTitle">Detectarea automată a participanților</sys:String>
    <sys:String x:Key="Calls.AutoDetectText">Neimplementată. VIZEN nu detectează automat participanții și nu va pretinde acest lucru până când funcția nu este construită și testată.</sys:String>

