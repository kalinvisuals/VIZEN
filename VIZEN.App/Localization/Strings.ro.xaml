    <sys:String x:Key="Notes.Convert">Convertește</sys:String>
    <sys:String x:Key="Notes.ConvertTip">Text → listă (un element pe fiecare rând) sau listă → text („[x]” marchează elementele bifate). Nu se pierde nimic.</sys:String>
    <sys:String x:Key="Notes.Delete">Șterge notița</sys:String>
